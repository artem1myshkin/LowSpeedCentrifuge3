    {
        "id": "bd6ed960fad6ad07",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": "pos_convert",
        "func": "let a = msg.payload[8]*65536 + msg.payload[9];\nlet rez = (a & 0xfffff | 0x100000) * 1.0 / Math.pow(2, 52 - 32) * Math.pow(2, ((a >> 52 - 32 & 0x7ff) - 1023));\n\nif (rez < 0.00001) rez = 0;\n\nmsg.raw_angle = a;\nmsg.position = rez;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1010,
        "y": 1380,
        "wires": [
            [
                "9a0399a6d82c8576"
            ]
        ]
    },
