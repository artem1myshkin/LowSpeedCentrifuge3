    {
        "id": "06284299389e9a03",
        "type": "inject",
        "z": "5aa5c3258e2560f3",
        "name": "",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "ch1/data",
        "payload": "789",
        "payloadType": "num",
        "x": 130,
        "y": 100,
        "wires": [
