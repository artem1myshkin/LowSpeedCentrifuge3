        "height": "40",
        "head": "",
        "format": "<template>\n  <v-container class=\"containter\">\n    <h1 class=\"mt-1 ml-4 mb-1\">{{ t('settings_title') }}</h1>\n    <v-card class=\"elevation-4 pa-4\">\n\n      <!-- Инициализация привода -->\n      <v-row class=\"mb-4\">\n        <v-col cols=\"12\" class=\"d-flex gap-4 align-center\">\n          <v-btn class=\"mr-6\" color=\"primary\" @click=\"driveInit\" :disabled=\"!isActiveUser\">{{ t('drive_init') }}</v-btn>\n        </v-col>\n      </v-row>\n\n      <!-- Основные настройки -->\n      <v-row class=\"mb-4\">\n        <v-col cols=\"12\">\n          <v-switch v-model=\"settings.general.remoteControl\" :label=\"t('remote_control')\" hide-details></v-switch>\n        </v-col>\n        <v-col cols=\"12\">\n          <v-switch v-model=\"settings.general.angleCorrectionEnabled\" :label=\"t('angle_correction')\"></v-switch>\n        </v-col>\n        <v-col cols=\"12\">\n          <h3 class=\"mb-2\">{{ t('angle_saving_title') }}</h3>\n          <v-radio-group v-model=\"settings.general.angleSavingMode\" row>\n            <v-radio :label=\"t('angle_saving_none')\" value=\"none\"></v-radio>\n            <v-radio :label=\"t('angle_saving_header')\" value=\"header\"></v-radio>\n          </v-radio-group>\n        </v-col>\n      </v-row>\n\n      <!-- Выбор языка -->\n      <v-row class=\"mb-3\">\n        <v-col cols=\"12\" md=\"6\">\n          <v-select\n            v-model=\"settings.general.language\"\n            :items=\"['Russian', 'English']\"\n            :label=\"t('interface_language')\"\n          ></v-select>\n        </v-col>\n      </v-row>\n\n      <!-- Продвинутые настройки с защитой паролем -->\n      <v-expansion-panels v-model=\"panels\" multiple>\n        <v-expansion-panel value=\"advanced\">\n          <v-expansion-panel-title>\n            {{ t('advanced_settings') }}\n            <v-icon v-if=\"!advancedUnlocked\" color=\"grey\" class=\"ml-2\">mdi-lock</v-icon>\n            <v-icon v-else color=\"green\" class=\"ml-2\">mdi-lock-open</v-icon>\n          </v-expansion-panel-title>\n\n          <v-expansion-panel-text>\n            <!-- Форма ввода пароля -->\n            <div v-if=\"!advancedUnlocked\" class=\"pa-6\">\n              <v-text-field\n                v-model=\"passwordInput\"\n                :label=\"t('password_label')\"\n                :type=\"showPassword ? 'text' : 'password'\"\n                :append-icon=\"showPassword ? 'mdi-eye' : 'mdi-eye-off'\"\n                @click:append=\"showPassword = !showPassword\"\n                @keyup.enter=\"unlockAdvanced\"\n                autocomplete=\"off\"\n                outlined\n                dense\n                :hint=\"t('password_hint')\"\n                persistent-hint\n              ></v-text-field>\n\n              <div class=\"d-flex justify-space-between mt-3\">\n                <div v-if=\"passwordError\" class=\"red--text\">{{ t('wrong_password') }}</div>\n                <v-spacer></v-spacer>\n                <v-btn color=\"primary\" @click=\"unlockAdvanced\" :loading=\"checkingPassword\">\n                  {{ t('unlock_button') }}\n                </v-btn>\n              </div>\n            </div>\n\n            <!-- Продвинутые настройки (после разблокировки) -->\n            <div v-else>\n              <!-- Периоды чтения -->\n              <v-row class=\"mb-3\" dense>\n                <v-col cols=\"12\" md=\"4\">\n                  <v-text-field\n                    v-model.number=\"settings.advanced.readPeriodRotation\"\n                    type=\"number\"\n                    :label=\"t('read_period_rotation')\"\n                  ></v-text-field>\n                </v-col>\n                <v-col cols=\"12\" md=\"4\">\n                  <v-text-field\n                    v-model.number=\"settings.advanced.readPeriodTilt\"\n                    type=\"number\"\n                    :label=\"t('read_period_tilt')\"\n                  ></v-text-field>\n                </v-col>\n                <v-col cols=\"12\" md=\"4\">\n                  <v-text-field\n                    v-model.number=\"settings.advanced.readPeriodBEP\"\n                    type=\"number\"\n                    :label=\"t('read_period_bep')\"\n                  ></v-text-field>\n                </v-col>\n              </v-row>\n\n              <!-- Диапазоны -->\n              <v-row class=\"mb-3\">\n                <v-col cols=\"12\" md=\"6\">\n                  <h4>{{ t('rotation_speed_range') }}</h4>\n                  <div class=\"d-flex justify-between mb-1\"><span>{{ t('min_speed') }}</span></div>\n                  <div class=\"d-flex gap-2 mb-2\">\n                    <v-text-field v-model.number=\"settings.advanced.rotationSpeed.min.deg\" :label=\"t('deg')\" type=\"number\"></v-text-field>\n                    <v-text-field v-model.number=\"settings.advanced.rotationSpeed.min.min\" :label=\"t('min')\" type=\"number\"></v-text-field>\n                    <v-text-field v-model.number=\"settings.advanced.rotationSpeed.min.sec\" :label=\"t('sec')\" type=\"number\"></v-text-field>\n                  </div>\n                  <div class=\"d-flex justify-between mb-1\"><span>{{ t('max_speed') }}</span></div>\n                  <div class=\"d-flex gap-2 mb-2\">\n                    <v-text-field v-model.number=\"settings.advanced.rotationSpeed.max.deg\" :label=\"t('deg')\" type=\"number\"></v-text-field>\n                    <v-text-field v-model.number=\"settings.advanced.rotationSpeed.max.min\" :label=\"t('min')\" type=\"number\"></v-text-field>\n                    <v-text-field v-model.number=\"settings.advanced.rotationSpeed.max.sec\" :label=\"t('sec')\" type=\"number\"></v-text-field>\n                  </div>\n                </v-col>\n\n                <v-col cols=\"12\" md=\"6\">\n                  <h4>{{ t('tilt_angle_range') }}</h4>\n                  <div class=\"d-flex justify-between mb-1\"><span>{{ t('min_angle') }}</span></div>\n                  <div class=\"d-flex gap-2 mb-2\">\n                    <v-text-field v-model.number=\"settings.advanced.tiltAngle.min.deg\" :label=\"t('deg')\" type=\"number\"></v-text-field>\n                    <v-text-field v-model.number=\"settings.advanced.tiltAngle.min.min\" :label=\"t('min')\" type=\"number\"></v-text-field>\n                    <v-text-field v-model.number=\"settings.advanced.tiltAngle.min.sec\" :label=\"t('sec')\" type=\"number\"></v-text-field>\n                  </div>\n                  <div class=\"d-flex justify-between mb-1\"><span>{{ t('max_angle') }}</span></div>\n                  <div class=\"d-flex gap-2 mb-2\">\n                    <v-text-field v-model.number=\"settings.advanced.tiltAngle.max.deg\" :label=\"t('deg')\" type=\"number\"></v-text-field>\n                    <v-text-field v-model.number=\"settings.advanced.tiltAngle.max.min\" :label=\"t('min')\" type=\"number\"></v-text-field>\n                    <v-text-field v-model.number=\"settings.advanced.tiltAngle.max.sec\" :label=\"t('sec')\" type=\"number\"></v-text-field>\n                  </div>\n                </v-col>\n              </v-row>\n\n              <!-- Скорость переключения энкодеров -->\n              <v-row class=\"mb-3\">\n                <v-col cols=\"12\" md=\"6\">\n                  <h4>{{ t('encoder_switch_speed') }}</h4>\n                  <div class=\"d-flex gap-2 mb-2\">\n                    <v-text-field v-model.number=\"settings.advanced.encoderSwitchSpeed.deg\" :label=\"t('deg')\" type=\"number\"></v-text-field>\n                    <v-text-field v-model.number=\"settings.advanced.encoderSwitchSpeed.min\" :label=\"t('min')\" type=\"number\"></v-text-field>\n                    <v-text-field v-model.number=\"settings.advanced.encoderSwitchSpeed.sec\" :label=\"t('sec')\" type=\"number\"></v-text-field>\n                  </div>\n                </v-col>\n              </v-row>\n\n              <!-- Коэффициенты БЕП -->\n              <v-row class=\"mb-3\">\n                <v-col cols=\"12\" md=\"6\">\n                  <h4>{{ t('bep_calibration_coeffs') }}</h4>\n                  <v-text-field v-model.number=\"settings.advanced.BEPcoeffs[0]\" :label=\"t('coeff_1')\" type=\"number\"></v-text-field>\n                  <v-text-field v-model.number=\"settings.advanced.BEPcoeffs[1]\" :label=\"t('coeff_2')\" type=\"number\"></v-text-field>\n                  <v-text-field v-model.number=\"settings.advanced.BEPcoeffs[2]\" :label=\"t('coeff_3')\" type=\"number\"></v-text-field>\n                  <v-text-field v-model.number=\"settings.advanced.BEPcoeffs[3]\" :label=\"t('coeff_4')\" type=\"number\"></v-text-field>\n                  <v-text-field v-model.number=\"settings.advanced.BEPcoeffs[4]\" :label=\"t('coeff_5')\" type=\"number\"></v-text-field>\n                </v-col>\n              </v-row>\n\n              <!-- Круглограмма и калибровка энкодеров -->\n              <v-row>\n                <v-col cols=\"12\">\n                  <v-textarea\n                    v-model=\"settings.advanced.aerostaticSupportDiagram\"\n                    :label=\"t('aerostatic_diagram')\"\n                    rows=\"4\"\n                    :placeholder=\"t('aerostatic_placeholder')\"\n                  ></v-textarea>\n                </v-col>\n              </v-row>\n              <v-row>\n                <v-col cols=\"12\">\n                  <v-textarea\n                    v-model=\"settings.advanced.encoderCalibrationLines\"\n                    :label=\"t('encoder_calibration')\"\n                    rows=\"4\"\n                    :placeholder=\"t('encoder_calibration_placeholder')\"\n                  ></v-textarea>\n                </v-col>\n              </v-row>\n            </div>\n          </v-expansion-panel-text>\n        </v-expansion-panel>\n      </v-expansion-panels>\n\n      <!-- Кнопка сохранения -->\n      <v-row class=\"mt-6\">\n        <v-col cols=\"12\" class=\"d-flex justify-end\">\n          <v-btn color=\"success\" @click=\"saveSettings\" large>\n            {{ t('save_settings') }}\n          </v-btn>\n        </v-col>\n      </v-row>\n    </v-card>\n  </v-container>\n</template>\n\n<script>\nexport default {\n  name: 'SettingsTab',\n  data() {\n    return {\n      panels: [],\n      passwordInput: '',\n      showPassword: false,\n      passwordError: false,\n      checkingPassword: false,\n      advancedUnlocked: false,\n      isActiveUser: false,\n      currentSession: {\n      socketId: '',\n      socketIp: ''\n      },\n      activeSession: {\n        socketId: '',\n        socketIp: ''\n      },\n      settings: {\n        general: {\n          remoteControl: false,\n          angleCorrectionEnabled: true,\n          language: 'Russian',  // Russian | English\n          angleSavingMode: 'header'\n        },\n        advanced: {\n          readPeriodRotation: 100,\n          readPeriodTilt: 100,\n          readPeriodBEP: 100,\n          rotationSpeed: { min: { deg: 0, min: 0, sec: 0 }, max: { deg: 0, min: 0, sec: 0 } },\n          tiltAngle: { min: { deg: 0, min: 0, sec: 0 }, max: { deg: 0, min: 0, sec: 0 } },\n          encoderSwitchSpeed: { deg: 0, min: 0, sec: 0 },\n          BEPcoeffs: [0, 0, 0, 0, 0],\n          aerostaticSupportDiagram: '',\n          encoderCalibrationLines: '',\n        }\n      },\n\n      // === Переводы ===\n      translations: {\n        Russian: {\n          settings_title: \"Настройка\",\n          drive_init: \"Drive Init\",\n          remote_control: \"Удаленное управление\",\n          angle_correction: \"Поправка к углу наклона\",\n          angle_saving_title: \"Сохранение угла наклона оси вращения\",\n          angle_saving_none: \"Не сохранять\",\n          angle_saving_header: \"Сохранять в заголовке файла\",\n          interface_language: \"Язык интерфейса\",\n          advanced_settings: \"Продвинутые настройки\",\n          password_label: \"Пароль для доступа к продвинутым настройкам\",\n          password_hint: \"Подсказка: пароль начинается с заглавной S\",\n          wrong_password: \"Неверный пароль\",\n          unlock_button: \"Разблокировать\",\n          read_period_rotation: \"Период чтения угла поворота (мс)\",\n          read_period_tilt: \"Период чтения угла наклона (мс)\",\n          read_period_bep: \"Период чтения БЕП (мс)\",\n          rotation_speed_range: \"Диапазон скоростей вращения\",\n          tilt_angle_range: \"Диапазон углов наклона\",\n          min_speed: \"Мин. скорость\",\n          max_speed: \"Макс. скорость\",\n          min_angle: \"Мин. угол\",\n          max_angle: \"Макс. угол\",\n          encoder_switch_speed: \"Скорость переключения пар энкодеров\",\n          bep_calibration_coeffs: \"Калибровочные коэффициенты БЕП\",\n          coeff_1: \"Коэффициент 1\",\n          coeff_2: \"Коэффициент 2\",\n          coeff_3: \"Коэффициент 3\",\n          coeff_4: \"Коэффициент 4\",\n          coeff_5: \"Коэффициент 5\",\n          aerostatic_diagram: \"Круглограмма аэростатической опоры\",\n          aerostatic_placeholder: \"Данные пробного вращения 2-3 оборота со скоростью 5-10 °/с\",\n          encoder_calibration: \"Калибровочные коэффициенты пар энкодеров\",\n          encoder_calibration_placeholder: \"Введите калибровочные коэффициенты пар энкодеров\",\n          deg: \"Градусы (°)\",\n          min: \"Минуты (′)\",\n          sec: \"Секунды (″)\",\n          save_settings: \"Сохранить настройки\"\n        },\n        English: {\n          settings_title: \"Settings\",\n          drive_init: \"Drive Init\",\n          remote_control: \"Remote Control\",\n          angle_correction: \"Tilt Angle Correction\",\n          angle_saving_title: \"Saving Rotation Axis Tilt Angle\",\n          angle_saving_none: \"Do not save\",\n          angle_saving_header: \"Save in file header\",\n          interface_language: \"Interface Language\",\n          advanced_settings: \"Advanced Settings\",\n          password_label: \"Password for advanced settings\",\n          password_hint: \"Hint: password starts with capital S\",\n          wrong_password: \"Wrong password\",\n          unlock_button: \"Unlock\",\n          read_period_rotation: \"Rotation angle read period (ms)\",\n          read_period_tilt: \"Tilt angle read period (ms)\",\n          read_period_bep: \"BEP read period (ms)\",\n          rotation_speed_range: \"Rotation Speed Range\",\n          tilt_angle_range: \"Tilt Angle Range\",\n          min_speed: \"Min. speed\",\n          max_speed: \"Max. speed\",\n          min_angle: \"Min. angle\",\n          max_angle: \"Max. angle\",\n          encoder_switch_speed: \"Encoder pair switching speed\",\n          bep_calibration_coeffs: \"BEP Calibration Coefficients\",\n          coeff_1: \"Coefficient 1\",\n          coeff_2: \"Coefficient 2\",\n          coeff_3: \"Coefficient 3\",\n          coeff_4: \"Coefficient 4\",\n          coeff_5: \"Coefficient 5\",\n          aerostatic_diagram: \"Aerostatic support diagram\",\n          aerostatic_placeholder: \"Data from 2–3 test rotations at 5–10 °/s\",\n          encoder_calibration: \"Encoder pair calibration coefficients\",\n          encoder_calibration_placeholder: \"Enter encoder pair calibration coefficients\",\n          deg: \"Degrees (°)\",\n          min: \"Minutes (′)\",\n          sec: \"Seconds (″)\",\n          save_settings: \"Save Settings\"\n        }\n      }\n    };\n  },\n\n  methods: {\n    // Функция перевода — точно как в SpeedTab\n    t(key) {\n      const lang = this.settings.general.language; // Russian или English\n      return this.translations[lang]?.[key] || key;\n    },\n\n    driveInit() {\n      alert('Инициализация привода выполнена');\n    },\n\n    saveSettings() {\n      this.send({ payload: this.settings, topic: \"settings_aply\" });\n      this.advancedUnlocked = false;\n    },\n\n    async unlockAdvanced() {\n      if (!this.passwordInput) return;\n      this.checkingPassword = true;\n      this.passwordError = false;\n      try {\n        const isCorrect = await this.verifyPassword(this.passwordInput.trim());\n        if (isCorrect) {\n          this.advancedUnlocked = true;\n          this.passwordInput = '';\n          this.panels = ['advanced'];\n        } else {\n          this.passwordError = true;\n        }\n      } catch (err) {\n        console.error('Ошибка проверки пароля:', err);\n        this.passwordError = true;\n      } finally {\n        this.checkingPassword = false;\n      }\n    },\n\n    async verifyPassword(inputPassword) {\n      const EXPECTED_HASH_B64 = \"fGGn4NDbURtFQVzPbO1ADGTRv85Z00J5h7oCynl/qFg=\";\n      const SALT_B64 = \"a8f5c1d7e3b9f2g4h6j8k9m0n1p2q3r4\";\n      const ITERATIONS = 100000;\n\n      const encoder = new TextEncoder();\n      const salt = Uint8Array.from(atob(SALT_B64), c => c.charCodeAt(0));\n\n      const keyMaterial = await crypto.subtle.importKey(\n        \"raw\", encoder.encode(inputPassword), { name: \"PBKDF2\" }, false, [\"deriveBits\"]\n      );\n\n      const derivedBits = await crypto.subtle.deriveBits(\n        { name: \"PBKDF2\", salt, iterations: ITERATIONS, hash: \"SHA-256\" },\n        keyMaterial, 256\n      );\n\n      const derivedKey = btoa(String.fromCharCode(...new Uint8Array(derivedBits)));\n      return derivedKey === EXPECTED_HASH_B64;\n    },\n\n    handleIncoming(msg){\n      if(msg.topic == \"initiation\"){\n        this.settings.general.remoteControl = msg.settings.general.remoteControl ?? this.settings.general.remoteControl;\n        this.settings.general.angleCorrectionEnabled = msg.settings.general.angleCorrectionEnabled ?? this.settings.general.angleCorrectionEnabled;\n        this.settings.general.language = msg.settings.general.language ?? this.settings.general.language;\n        this.settings.general.angleSavingMode = msg.settings.general.angleSavingMode ?? this.settings.general.angleSavingMode;\n        this.settings.advanced.readPeriodRotation = msg.settings.advanced.readPeriodRotation ?? this.settings.advanced.readPeriodRotation;\n        this.settings.advanced.readPeriodTilt = msg.settings.advanced.readPeriodTilt ?? this.settings.advanced.readPeriodTilt;\n        this.settings.advanced.readPeriodBEP = msg.settings.advanced.readPeriodBEP ?? this.settings.advanced.readPeriodBEP;\n        this.settings.advanced.rotationSpeed = msg.settings.advanced.rotationSpeed ?? this.settings.advanced.rotationSpeed;\n        this.settings.advanced.tiltAngle = msg.settings.advanced.tiltAngle ?? this.settings.advanced.tiltAngle;\n        this.settings.advanced.encoderSwitchSpeed = msg.settings.advanced.encoderSwitchSpeed ?? this.settings.advanced.encoderSwitchSpeed;\n        this.settings.advanced.BEPcoeffs = msg.settings.advanced.BEPcoeffs ?? this.settings.advanced.BEPcoeffs;\n        this.settings.advanced.aerostaticSupportDiagram = msg.settings.advanced.aerostaticSupportDiagram ?? this.settings.advanced.aerostaticSupportDiagram;\n        this.settings.advanced.encoderCalibrationLines = msg.settings.advanced.encoderCalibrationLines ?? this.settings.advanced.encoderCalibrationLines;\n        console.log(1, msg.settings.general.remoteControl);\n        console.log(2, msg._client.socketIp);\n        console.log(3, msg.activeSession.socketIp);\n        console.log(4, this.isActiveUser);\n        this.isActiveUser = false; // сбрасываем в начале\n        \n        if (msg.settings.general.remoteControl == false) {\n        // локальный клиент\n        if(msg._client.socketIp == \"127.0.0.1\") {\n        this.isActiveUser = true;\n        }\n        } else {\n        // удаленный режим\n        if(msg._client.socketIp === msg.activeSession.socketIp){\n        this.isActiveUser = true;\n        }\n        }\n      }\n    }\n  },\n  mounted() {\n    this.send?.({ topic: \"reread\" });\n\n    this.$watch(\n      () => this.settings.general.remoteControl,\n      () => this.saveSettings()\n    );\n    \n    this.$watch(\n      () => this.settings.general.angleCorrectionEnabled,\n      () => this.saveSettings()\n    );\n    \n    this.$watch(\n      () => this.settings.general.angleSavingMode,\n      () => this.saveSettings()\n    );\n\n    this.$socket?.on(\"msg-input:\" + this.id, (msg) => {\n    try {\n    this.handleIncoming(msg);\n    } catch (e) {\n    console.error(e);\n    }\n    });\n  }\n};\n</script>\n\n<style scoped>\n.containter {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  margin: 20px;\n}\n.v-expansion-panel-title {\n  font-weight: bold;\n}\n</style>",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1930,
        "y": 2480,
        "wires": [
            [
                "b2d93ea4e038af8e"
            ]
        ]
    },
    {
        "id": "2ad82a0f02bba2ad",
        "type": "ui-template",
        "z": "5bbcbebf6ff74a86",
        "g": "52568354c3badd48",
        "group": "0a0c9b6ad340284b",
        "page": "",
        "ui": "",
        "name": "БУН",
        "order": 2,
        "width": "4",
        "height": "14",
        "head": "",
        "format": "<template>\n  <div class=\"bun-wrap\">\n    <h2 class=\"bun-title\">{{ t(\"group_name\") }}</h2>\n\n    <!-- ======= РЕЖИМ ======= -->\n    <div class=\"bun-section\">\n      <div class=\"bun-section__label\">{{ t(\"select_mode\") }}</div>\n      <v-select\n        v-model=\"tilt.mode\"\n        :items=\"modeOptions\"\n        item-title=\"label\"\n        item-value=\"value\"\n        outlined\n        dense\n        hide-details\n        class=\"bun-select\"\n        @update:model-value=\"changeMode\"\n      />\n    </div>\n\n    <!-- ======= ТЕКУЩИЙ УГОЛ ======= -->\n    <div class=\"bun-section\">\n      <div class=\"bun-section__label\">{{ t(\"current_angle\") }}</div>\n      <div class=\"bun-angle-display\">{{ currentAngleDMS }}</div>\n    </div>\n\n    <!-- ======= ЗАДАТЬ УГОЛ ======= -->\n    <div class=\"bun-section\">\n      <div class=\"bun-section__label\">{{ t(\"set_angle\") }}</div>\n      <div class=\"bun-angle-grid\">\n        <input\n          class=\"plain-input\"\n          type=\"number\"\n          v-model.number=\"angleInput.deg\"\n          :placeholder=\"t('degrees')\"\n          @change=\"updateTargetFromDMS\"\n        />\n        <input\n          class=\"plain-input\"\n          type=\"number\"\n          v-model.number=\"angleInput.min\"\n          :placeholder=\"t('minutes')\"\n          @change=\"updateTargetFromDMS\"\n        />\n        <input\n          class=\"plain-input\"\n          type=\"number\"\n          v-model.number=\"angleInput.sec\"\n          :placeholder=\"t('seconds')\"\n          @change=\"updateTargetFromDMS\"\n        />\n      </div>\n    </div>\n\n    <!-- ======= SET / STOP / ТОРМОЗ ======= -->\n    <div class=\"bun-section\">\n      <div class=\"bun-row\">\n        <button class=\"plain-btn btn-apply\" @click=\"setAngle\">{{ t(\"set\") }}</button>\n        <button class=\"plain-btn btn-stop\" @click=\"sendCmd('stop')\">\n          <v-icon size=\"16\" class=\"btn-icon\">mdi-stop-circle</v-icon>{{ t(\"stop\") }}\n        </button>\n      </div>\n      <div class=\"bun-brake-row\">\n        <v-icon :color=\"tilt.brake ? '#49c514' : '#e53935'\" size=\"20\">mdi-cog-stop</v-icon>\n        <span class=\"bun-brake-label\">{{ t(\"brake\") }} <strong>{{ brakeStatus }}</strong></span>\n        <v-switch\n          v-model=\"tilt.brake\"\n          @change=\"toggleBrake\"\n          hide-details\n          inset\n          color=\"primary\"\n          :disabled=\"tilt.mode === 'Автоматический' || tilt.mode === 'Automatic'\"\n          class=\"bun-switch\"\n        />\n      </div>\n    </div>\n\n    <!-- ======= УПРАВЛЕНИЕ НАКЛОНОМ ======= -->\n    <div class=\"bun-section\">\n      <div class=\"bun-section__label\">{{ t(\"tilt_control\") }}</div>\n      <div class=\"bun-ctrl-grid\">\n        <button class=\"plain-btn btn-release\" @click=\"sendCmd('release')\">\n          <v-icon size=\"16\" class=\"btn-icon\">mdi-hand-back-right</v-icon>{{ t(\"release\") }}\n        </button>\n        <button class=\"plain-btn btn-zero\" @click=\"sendCmd('zero')\">\n          <v-icon size=\"16\" class=\"btn-icon\">mdi-axis-arrow</v-icon>{{ t(\"zero\") }}\n        </button>\n        <button class=\"plain-btn btn-slowup\" @click=\"sendCmd('slowup')\">\n          <v-icon size=\"16\" class=\"btn-icon\">mdi-arrow-up-bold</v-icon>{{ t(\"slow_up\") }}\n        </button>\n        <button class=\"plain-btn btn-slowdn\" @click=\"sendCmd('slowdown')\">\n          <v-icon size=\"16\" class=\"btn-icon\">mdi-arrow-down-bold</v-icon>{{ t(\"slow_down\") }}\n        </button>\n      </div>\n    </div>\n\n    <!-- ======= СОСТОЯНИЕ СИСТЕМЫ ======= -->\n    <div class=\"bun-sysstate\">\n      <v-icon color=\"primary\" size=\"18\">mdi-information</v-icon>\n      <span>SYS_STATE: <strong>{{ systemState }}</strong></span>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"TiltTab\",\n  data() {\n    return {\n      system: { language: \"english\" },\n      tilt: {\n        mode: \"Ручной\",\n        brake: true,\n        targetAngle: 0,\n        currentAngle: 0,\n      },\n      angleInput: { deg: 0, min: 0, sec: 0 },\n      systemState: \"0x00\",\n    };\n  },\n  computed: {\n    modeOptions() {\n      return this.system.language === \"english\"\n        ? [\n            { label: \"Manual\",    value: \"Manual\" },\n            { label: \"Automatic\", value: \"Automatic\" },\n          ]\n        : [\n            { label: \"Ручной\",         value: \"Ручной\" },\n            { label: \"Автоматический\", value: \"Автоматический\" },\n          ];\n    },\n    brakeStatus() {\n      if (this.tilt.brake)\n        return this.system.language === \"english\" ? \"ON\" : \"ВКЛ\";\n      return this.system.language === \"english\" ? \"OFF\" : \"ВЫКЛ\";\n    },\n    currentAngleDMS() {\n      const { deg, min, sec } = this.toDMS(this.tilt.currentAngle);\n      return `${deg}° ${min}′ ${sec.toFixed(1)}″`;\n    },\n  },\n  methods: {\n    t(key) {\n      const lang = this.system.language;\n      const dict = {\n        group_name:    lang === \"english\" ? \"Tilt\"              : \"БУН\",\n        select_mode:   lang === \"english\" ? \"Select mode:\"      : \"Режим:\",\n        set_angle:     lang === \"english\" ? \"Set tilt angle:\"   : \"Задать угол наклона:\",\n        current_angle: lang === \"english\" ? \"Current angle:\"    : \"Текущий угол:\",\n        degrees:       lang === \"english\" ? \"Deg...\"            : \"Град...\",\n        minutes:       lang === \"english\" ? \"Min...\"            : \"Мин...\",\n        seconds:       lang === \"english\" ? \"Sec...\"            : \"Сек...\",\n        set:           lang === \"english\" ? \"Set\"               : \"Установить\",\n        stop:          lang === \"english\" ? \"Stop\"              : \"Стоп\",\n        brake:         lang === \"english\" ? \"Brake:\"            : \"Тормоз:\",\n        tilt_control:  lang === \"english\" ? \"Tilt control\"      : \"Управление наклоном\",\n        release:       lang === \"english\" ? \"Release\"           : \"Release\",\n        zero:          lang === \"english\" ? \"Set Zero\"          : \"Нулевой угол\",\n        slow_down:     lang === \"english\" ? \"Slow Down\"         : \"Меньше\",\n        slow_up:       lang === \"english\" ? \"Slow Up\"           : \"Больше\",\n      };\n      return dict[key] || key;\n    },\n    updateTargetFromDMS() {\n      const d = Number(this.angleInput.deg) || 0;\n      const m = Number(this.angleInput.min) || 0;\n      const s = Number(this.angleInput.sec) || 0;\n      const sign = d < 0 ? -1 : 1;\n      this.tilt.targetAngle = sign * (Math.abs(d) * 3600 + m * 60 + s);\n      this.updateTargetAngle();\n    },\n    toDMS(seconds) {\n      const sign = seconds < 0 ? -1 : 1;\n      const abs  = Math.abs(seconds);\n      return {\n        deg: Math.floor(abs / 3600) * sign,\n        min: Math.floor((abs % 3600) / 60),\n        sec: abs % 60,\n      };\n    },\n    changeMode()       { this.send?.({ topic: \"tilt_mode\",       payload: this.tilt.mode }); },\n    setAngle()         { this.send?.({ topic: \"bun_cmd_setpoint\", payload: this.tilt.targetAngle }); },\n    updateTargetAngle(){ this.send?.({ topic: \"tilt_target\",      payload: this.tilt.targetAngle }); },\n    toggleBrake()      { this.send?.({ topic: \"tilt_brake\",       payload: this.tilt.brake ? 1 : 0 }); },\n    sendCmd(cmd)       { this.send?.({ topic: \"bun_cmd\",          payload: cmd }); },\n  },\n  watch: {\n    \"tilt.targetAngle\"(val) { this.angleInput = this.toDMS(val); },\n  },\n  mounted() {\n    this.angleInput = this.toDMS(this.tilt.targetAngle);\n    this.send?.({ topic: \"reread\" });\n    this.$socket.on(\"msg-input:\" + this.id, (msg) => {\n      if (msg.topic === \"init\") {\n        console.log(msg);\n        this.system.language = msg.language || \"english\";\n        this.tilt.brake      = msg.bun_brake || false;\n      }\n      if (msg.topic === \"bun_sysstate\") this.systemState       = msg.payload || \"0x00\";\n      if (msg.topic === \"bun_angle\")    this.tilt.currentAngle = msg.payload || 0;\n    });\n  },\n};\n</script>\n\n<style scoped>\n/* ── обёртка ── */\n.bun-wrap {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding: 12px 14px;\n  height: 100%;\n  box-sizing: border-box;\n}\n\n.bun-title {\n  font-size: 22px;\n  font-weight: 700;\n  color: #1a1a1a;\n  margin: 0 0 4px 0;\n}\n\n/* ── секция ── */\n.bun-section {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.bun-section__label {\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: #888;\n  border-bottom: 1px solid #e0e0e0;\n  padding-bottom: 3px;\n}\n\n/* ── текущий угол ── */\n.bun-angle-display {\n  font-size: 26px;\n  font-weight: 700;\n  color: #1394ff;\n  letter-spacing: 0.02em;\n}\n\n/* ── поля ввода угла ── */\n.bun-angle-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr;\n  gap: 6px;\n}\n\n/* ── общий стиль кнопок (совпадает с БЕП) ── */\n.plain-btn {\n  height: 48px;\n  min-height: 48px;\n  max-height: 48px;\n  border: none;\n  border-radius: 6px;\n  color: #fff;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n  padding: 0 10px;\n  line-height: 46px;\n  transition: filter 0.15s;\n}\n.plain-btn:hover  { filter: brightness(1.1); }\n.plain-btn:active { filter: brightness(0.9); }\n\n/* ── поля ввода (совпадает с БЕП) ── */\n.plain-input {\n  height: 48px;\n  min-height: 48px;\n  max-height: 48px;\n  border: 1px solid #bdbdbd;\n  border-radius: 6px;\n  padding: 0 10px;\n  font-size: 14px;\n  color: #222;\n  background: #fff;\n  box-sizing: border-box;\n  width: 100%;\n  outline: none;\n  transition: border-color 0.2s;\n}\n.plain-input:focus { border-color: #1394ff; }\n\n/* ── строка Set / Stop ── */\n.bun-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n}\n\n/* ── строка тормоза ── */\n.bun-brake-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 0;\n}\n.bun-brake-label {\n  font-size: 14px;\n  flex: 1;\n}\n.bun-switch {\n  margin: 0;\n  padding: 0;\n}\n\n/* ── сетка управления наклоном 2×2 ── */\n.bun-ctrl-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n}\n\n/* ── состояние системы ── */\n.bun-sysstate {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 14px;\n  color: #444;\n  margin-top: auto;\n  padding-top: 8px;\n  border-top: 1px solid #e0e0e0;\n}\n\n/* ── цвета кнопок ── */\n.btn-apply   { background: #49c514; }\n.btn-stop    { background: #e53935; }\n.btn-release { background: #9c27b0; }\n.btn-zero    { background: #607d8b; }\n.btn-slowup  { background: #2196f3; }\n.btn-slowdn  { background: #ff9800; }\n\n.btn-icon { pointer-events: none; }\n</style>",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 2350,
        "y": 420,
        "wires": [
            [
                "30120c1bddd81915",
                "321c93180471316c"
            ]
        ]
    },
    {
        "id": "e317e782d21e704d",
        "type": "ui-template",
        "z": "5bbcbebf6ff74a86",
        "g": "768318bb2b74ee44",
        "group": "eb32c959bf58e08d",
        "page": "",
        "ui": "",
        "name": "Угловая скорость",
        "order": 1,
        "width": "7",
        "height": "30",
        "head": "",
        "format": "<template>\n  <v-container class=\"hmi-root pa-3\" fluid>\n\n    <!-- ══ Snackbar: предупреждение о смене разрешения ═══════════ -->\n    <v-snackbar\n      v-model=\"resSnackbar\"\n      color=\"warning\"\n      location=\"top\"\n      :timeout=\"-1\"\n      elevation=\"4\"\n      rounded=\"lg\"\n    >\n      <div class=\"d-flex align-center gap-2\">\n        <v-icon>mdi-alert</v-icon>\n        <span class=\"font-weight-bold\">{{ tr('res_warning_title') }}</span>\n      </div>\n      <div class=\"text-body-2 mt-1\">{{ tr('res_warning_body') }}</div>\n      <template #actions>\n        <v-btn variant=\"text\" color=\"white\" size=\"small\" @click=\"resSnackbar = false\">\n          {{ tr('res_warning_close') }}\n        </v-btn>\n      </template>\n    </v-snackbar>\n\n    <!-- ══ HEADER ══════════════════════════════════════════════════ -->\n    <div class=\"hmi-header mb-4\">\n      <div class=\"d-flex align-center gap-3\">\n        <div class=\"hmi-title\">{{ tr(\"angular_speed\") }}</div>\n        <v-chip\n          :color=\"resolution === 'high' ? 'cyan-darken-2' : 'amber-darken-2'\"\n          size=\"small\" variant=\"elevated\" class=\"resolution-chip font-mono\"\n        >\n          <v-icon start size=\"14\">mdi-sine-wave</v-icon>\n          {{ resolution === 'high' ? tr('res_high') : tr('res_low') }}\n          &nbsp;·&nbsp;{{ resolution === 'high' ? '262 144 000' : '6 553 600' }} {{ tr('ticks_per_rev') }}\n        </v-chip>\n        <v-chip :color=\"msChipColor\" size=\"small\" variant=\"flat\" class=\"font-mono\">\n          {{ msLabel }}\n        </v-chip>\n      </div>\n      <div class=\"d-flex align-center gap-2\">\n        <v-btn\n          color=\"deep-purple-lighten-1\" variant=\"elevated\"\n          size=\"small\" prepend-icon=\"mdi-refresh\" @click=\"driveInit\"\n        >Drive Init</v-btn>\n      </div>\n    </div>\n\n    <!-- ══ ROW 1: Motor Control + Drive Status ══════════════════════ -->\n    <v-row dense class=\"mb-2\">\n\n      <v-col cols=\"12\" md=\"6\">\n        <div class=\"hmi-card\">\n          <div class=\"hmi-card-title\">\n            <v-icon size=\"16\" class=\"mr-1\">mdi-engine</v-icon>{{ tr(\"motor_control\") }}\n          </div>\n          <div class=\"motor-btn-row mt-2\">\n            <v-btn\n              :color=\"current.mo ? 'green-darken-1' : 'green'\"\n              variant=\"elevated\" class=\"motor-btn\"\n              prepend-icon=\"mdi-power\" @click=\"sendCmd('motor_on')\"\n              :disabled=\"current.mo\"\n            >{{ tr(\"motor_on\") }}</v-btn>\n\n            <v-btn\n              :color=\"!current.mo ? 'orange-darken-1' : 'orange'\"\n              variant=\"elevated\" class=\"motor-btn\"\n              :class=\"{ 'motor-btn--pulse': resSnackbar && current.mo }\"\n              prepend-icon=\"mdi-power-off\" @click=\"sendCmd('motor_off')\"\n              :disabled=\"!current.mo\"\n            >{{ tr(\"motor_off\") }}</v-btn>\n\n            <v-btn\n              color=\"red-darken-1\" variant=\"elevated\" class=\"motor-btn\"\n              prepend-icon=\"mdi-stop-circle-outline\" @click=\"sendCmd('drive_stop')\"\n            >STOP</v-btn>\n\n            <v-btn\n              color=\"blue-darken-1\" variant=\"elevated\" class=\"motor-btn\"\n              prepend-icon=\"mdi-home\" @click=\"sendCmd('drive_home')\"\n            >HOME</v-btn>\n          </div>\n        </div>\n      </v-col>\n\n      <v-col cols=\"12\" md=\"6\">\n        <div class=\"hmi-card\">\n          <div class=\"hmi-card-title\">\n            <v-icon size=\"16\" class=\"mr-1\">mdi-information-outline</v-icon>{{ tr(\"drive_status\") }}\n          </div>\n          <div class=\"status-grid mt-2\">\n\n            <div class=\"status-indicator\" :class=\"current.mo ? 'si--on' : 'si--off'\">\n              <div class=\"si-icon-wrap\">\n                <v-icon size=\"20\">{{ current.mo ? 'mdi-power' : 'mdi-power-off' }}</v-icon>\n              </div>\n              <div class=\"si-body\">\n                <div class=\"si-label\">MO</div>\n                <div class=\"si-value\">{{ current.mo ? '1 — ВКЛ' : '0 — ВЫКЛ' }}</div>\n              </div>\n            </div>\n\n            <div class=\"status-indicator\" :class=\"current.so ? 'si--on' : 'si--error'\">\n              <div class=\"si-icon-wrap\">\n                <v-icon size=\"20\">{{ current.so ? 'mdi-check-circle' : 'mdi-alert-circle' }}</v-icon>\n              </div>\n              <div class=\"si-body\">\n                <div class=\"si-label\">SO</div>\n                <div class=\"si-value\">{{ current.so ? '1 — Готов' : '0 — Не готов' }}</div>\n              </div>\n            </div>\n\n            <div class=\"status-indicator\" :class=\"'si--ms-' + current.ms\">\n              <div class=\"si-icon-wrap\">\n                <v-icon size=\"20\">{{ current.ms === 2 ? 'mdi-rotate-right' : current.ms === 0 ? 'mdi-crosshairs-gps' : current.ms === 1 ? 'mdi-flag-checkered' : 'mdi-pause-circle' }}</v-icon>\n              </div>\n              <div class=\"si-body\">\n                <div class=\"si-label\">MS</div>\n                <div class=\"si-value\">{{ current.ms }} — {{ msLabel }}</div>\n              </div>\n            </div>\n\n            <div class=\"status-indicator\" :class=\"current.sr_status.ok ? 'si--on' : 'si--error'\">\n              <div class=\"si-icon-wrap\">\n                <v-icon size=\"20\">{{ current.sr_status.ok ? 'mdi-shield-check' : 'mdi-shield-alert' }}</v-icon>\n              </div>\n              <div class=\"si-body\">\n                <div class=\"si-label\">SR</div>\n                <div class=\"si-value\">{{ current.sr_status.ok ? tr('no_errors') : tr('sr_fault') }}</div>\n              </div>\n            </div>\n\n          </div>\n          <div v-if=\"current.sr_status.errors && current.sr_status.errors.length\" class=\"mt-2\">\n            <v-chip\n              v-for=\"(err, i) in current.sr_status.errors\" :key=\"i\"\n              color=\"red\" size=\"x-small\" variant=\"elevated\" class=\"mr-1 mb-1\"\n            >{{ err }}</v-chip>\n          </div>\n        </div>\n      </v-col>\n    </v-row>\n\n\n\n    <!-- ══ ROW 3: Motion Parameters + Current State ══════════════════ -->\n    <v-row dense class=\"mb-2\">\n\n      <v-col cols=\"12\" md=\"6\">\n        <div class=\"hmi-card\">\n          <div class=\"hmi-card-title\">\n            <v-icon size=\"16\" class=\"mr-1\">mdi-tune</v-icon>{{ tr(\"motion_parameters\") }}\n          </div>\n          <div class=\"mt-2\">\n            <div v-for=\"(param, key) in params\" :key=\"key\" class=\"param-row mb-3\">\n              <div class=\"param-row-label text-caption\">{{ tr(key) }}</div>\n              <div class=\"d-flex gap-1 align-center\">\n                <v-text-field\n                  v-model.number=\"param.deg\" :label=\"tr('deg_label')\" type=\"number\"\n                  density=\"compact\" hide-details variant=\"outlined\"\n                  class=\"param-field\"\n                ></v-text-field>\n                <span class=\"text-caption text-medium-emphasis px-1\">°</span>\n                <v-text-field\n                  v-model.number=\"param.min\" :label=\"tr('min_label')\" type=\"number\"\n                  density=\"compact\" hide-details variant=\"outlined\"\n                  class=\"param-field\"\n                ></v-text-field>\n                <span class=\"text-caption text-medium-emphasis px-1\">′</span>\n                <v-text-field\n                  v-model.number=\"param.sec\" :label=\"tr('sec_label')\" type=\"number\"\n                  density=\"compact\" hide-details variant=\"outlined\"\n                  class=\"param-field\"\n                ></v-text-field>\n                <span class=\"text-caption text-medium-emphasis px-1\">″</span>\n                <span class=\"param-ticks-badge font-mono text-caption\">\n                  {{ dmsToTicks(param) }} тик\n                </span>\n              </div>\n            </div>\n          </div>\n          <v-btn color=\"success\" block size=\"small\" class=\"mt-1\" @click=\"applyMotionParams\">\n            <v-icon start size=\"16\">mdi-check</v-icon>{{ tr(\"apply_parameters\") }}\n          </v-btn>\n        </div>\n      </v-col>\n\n      <v-col cols=\"12\" md=\"6\">\n        <div class=\"hmi-card\">\n          <div class=\"hmi-card-title\">\n            <v-icon size=\"16\" class=\"mr-1\">mdi-chart-line</v-icon>{{ tr(\"current_motion\") }}\n          </div>\n          <div class=\"state-grid mt-2\">\n\n            <div class=\"state-row\">\n              <span class=\"state-key\">{{ tr(\"position\") }}</span>\n              <span class=\"state-val font-mono\">{{ formatDeg(current.position) }}</span>\n              <span class=\"state-ticks font-mono\">{{ current.position }} тик</span>\n            </div>\n\n            <div class=\"state-row\">\n              <span class=\"state-key\">{{ tr(\"velocity\") }}</span>\n              <span class=\"state-val font-mono\">{{ formatSpeed(current.velocity) }}</span>\n              <span class=\"state-ticks font-mono\">{{ current.velocity }} тик/с</span>\n            </div>\n\n            <div class=\"state-row\">\n              <span class=\"state-key\">{{ tr(\"torque\") }}</span>\n              <span class=\"state-val font-mono\">{{ current.torque.toFixed(3) }}</span>\n              <span class=\"state-ticks\"></span>\n            </div>\n\n            <v-divider class=\"my-1\"></v-divider>\n            <div class=\"state-section-label\">{{ tr('set_values') }}</div>\n\n            <div class=\"state-row\">\n              <span class=\"state-key\">SP</span>\n              <span class=\"state-val font-mono\">{{ formatSpeed(current.sp) }}</span>\n              <span class=\"state-ticks font-mono\">{{ current.sp }} тик/с</span>\n            </div>\n\n            <div class=\"state-row\">\n              <span class=\"state-key\">AC</span>\n              <span class=\"state-val font-mono\">{{ formatAccel(current.ac) }}</span>\n              <span class=\"state-ticks font-mono\">{{ current.ac }} тик/с²</span>\n            </div>\n\n            <div class=\"state-row\">\n              <span class=\"state-key\">DC</span>\n              <span class=\"state-val font-mono\">{{ formatAccel(current.dc) }}</span>\n              <span class=\"state-ticks font-mono\">{{ current.dc }} тик/с²</span>\n            </div>\n\n            <div class=\"state-row\">\n              <span class=\"state-key\">TR[1]</span>\n              <span class=\"state-val font-mono\">{{ formatDeg(current.tr1) }}</span>\n              <span class=\"state-ticks font-mono\">{{ current.tr1 }} тик</span>\n            </div>\n          </div>\n        </div>\n      </v-col>\n    </v-row>\n\n    <!-- ══ ROW 2+4: Encoder Resolution + Move Command (объединённый блок) ══ -->\n    <v-row dense class=\"mb-2\">\n      <v-col cols=\"12\">\n        <div class=\"hmi-card\">\n\n          <!-- ═══ ГОРИЗОНТАЛЬНАЯ КОМПОНОВКА: разрешение | движение ══════ -->\n          <div class=\"combined-layout mt-1\">\n\n            <!-- ── Левая часть: Разрешение энкодера ───────────────────── -->\n            <div class=\"combined-left\">\n              <div class=\"combined-section-title mb-2\">\n                <v-icon size=\"15\" class=\"mr-1\">mdi-gauge</v-icon>{{ tr(\"encoder_resolution\") }}\n              </div>\n\n              <div class=\"res-option-row\">\n                <!-- Высокое -->\n                <div class=\"res-option\" :class=\"{ 'res-option--active': resolution === 'high' }\"\n                  @click=\"switchResolution('high')\">\n                  <div class=\"res-option-label\">{{ tr('res_high') }}</div>\n                  <div class=\"res-tpd font-mono\">728 178 {{ tr('ticks_per_deg') }}</div>\n                  <div class=\"res-tpr font-mono\">262 144 000 {{ tr('ticks_per_rev') }}</div>\n                </div>\n\n                <v-icon size=\"18\" color=\"grey-lighten-1\" class=\"res-swap-icon\">mdi-swap-horizontal</v-icon>\n\n                <!-- Низкое -->\n                <div class=\"res-option\" :class=\"{ 'res-option--active': resolution === 'low' }\"\n                  @click=\"switchResolution('low')\">\n                  <div class=\"res-option-label\">{{ tr('res_low') }}</div>\n                  <div class=\"res-tpd font-mono\">18 204 {{ tr('ticks_per_deg') }}</div>\n                  <div class=\"res-tpr font-mono\">6 553 600 {{ tr('ticks_per_rev') }}</div>\n                </div>\n              </div>\n            </div>\n\n            <!-- ── Вертикальный разделитель ────────────────────────────── -->\n            <div class=\"combined-vdivider\"></div>\n\n            <!-- ── Правая часть: Команда движения ─────────────────────── -->\n            <div class=\"combined-right\">\n              <div class=\"combined-section-title mb-2\">\n                <v-icon size=\"15\" class=\"mr-1\">mdi-cursor-move</v-icon>{{ tr(\"move_command\") }}\n              </div>\n\n              <div class=\"move-grid\">\n\n                <!-- Строка 1: переключатель единиц | Move ABS -->\n                <div class=\"move-grid-left\">\n                  <div class=\"d-flex align-center gap-2\">\n                    <span class=\"text-caption text-medium-emphasis\">{{ tr('input_mode') }}:</span>\n                    <v-btn-toggle v-model=\"moveInputMode\" density=\"compact\" color=\"primary\" variant=\"outlined\" mandatory>\n                      <v-btn value=\"dms\" size=\"x-small\">\n                        <v-icon size=\"14\" class=\"mr-1\">mdi-angle-acute</v-icon>° ′ ″\n                      </v-btn>\n                      <v-btn value=\"deg\" size=\"x-small\">\n                        <v-icon size=\"14\" class=\"mr-1\">mdi-decimal</v-icon>° дес.\n                      </v-btn>\n                      <v-btn value=\"ticks\" size=\"x-small\">\n                        <v-icon size=\"14\" class=\"mr-1\">mdi-counter</v-icon>тики\n                      </v-btn>\n                    </v-btn-toggle>\n                    <v-tooltip location=\"top\">\n                      <template #activator=\"{ props }\">\n                        <v-icon v-bind=\"props\" size=\"16\" color=\"blue-lighten-2\">mdi-information-outline</v-icon>\n                      </template>\n                      <span>1° = {{ Math.round(ticksPerDeg) }} тик ({{ resolution === 'high' ? 'высокое' : 'низкое' }} разрешение)</span>\n                    </v-tooltip>\n                  </div>\n                </div>\n\n                <div class=\"move-grid-right\">\n                  <v-btn color=\"teal-darken-1\" variant=\"elevated\"\n                    prepend-icon=\"mdi-map-marker-check\" @click=\"sendAbsoluteMove\" class=\"move-btn\">\n                    Move ABS\n                    <v-tooltip activator=\"parent\" location=\"top\">Абсолютное позиционирование (PA)</v-tooltip>\n                  </v-btn>\n                </div>\n\n                <!-- Строка 2: поле ввода | Move REL -->\n                <div class=\"move-grid-left\">\n                  <div v-if=\"moveInputMode === 'dms'\" class=\"d-flex gap-1 align-center\">\n                    <v-text-field v-model.number=\"moveTarget.deg\" label=\"град °\" type=\"number\"\n                      density=\"compact\" variant=\"outlined\" hide-details class=\"move-field\"></v-text-field>\n                    <v-text-field v-model.number=\"moveTarget.min\" label=\"мин ′\" type=\"number\"\n                      density=\"compact\" variant=\"outlined\" hide-details class=\"move-field\"></v-text-field>\n                    <v-text-field v-model.number=\"moveTarget.sec\" label=\"сек ″\" type=\"number\"\n                      density=\"compact\" variant=\"outlined\" hide-details class=\"move-field\"></v-text-field>\n                    <span class=\"font-mono text-caption text-medium-emphasis px-2 no-wrap\">\n                      = {{ dmsToTicks(moveTarget) }} тик\n                    </span>\n                  </div>\n                  <div v-if=\"moveInputMode === 'deg'\" class=\"d-flex gap-2 align-center\">\n                    <v-text-field v-model.number=\"moveTargetDeg\" label=\"Градусы (десятичные)\" type=\"number\"\n                      density=\"compact\" variant=\"outlined\" hide-details style=\"max-width:200px\"></v-text-field>\n                    <span class=\"font-mono text-caption text-medium-emphasis no-wrap\">\n                      = {{ Math.round((moveTargetDeg || 0) * ticksPerDeg) }} тик\n                    </span>\n                  </div>\n                  <div v-if=\"moveInputMode === 'ticks'\" class=\"d-flex gap-2 align-center\">\n                    <v-text-field v-model.number=\"moveTargetTicks\" label=\"Тики\" type=\"number\"\n                      density=\"compact\" variant=\"outlined\" hide-details style=\"max-width:200px\"></v-text-field>\n                    <span class=\"font-mono text-caption text-medium-emphasis no-wrap\">\n                      ≈ {{ formatDeg(moveTargetTicks || 0) }}\n                    </span>\n                  </div>\n                </div>\n\n                <div class=\"move-grid-right\">\n                  <v-btn color=\"indigo-darken-1\" variant=\"elevated\"\n                    prepend-icon=\"mdi-map-marker-distance\" @click=\"sendRelativeMove\" class=\"move-btn\">\n                    Move REL\n                    <v-tooltip activator=\"parent\" location=\"top\">Относительное перемещение (PR)</v-tooltip>\n                  </v-btn>\n                </div>\n\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </v-col>\n    </v-row>\n\n    <!-- ══ ROW 5: Scenario + SR details ════════════════════════════════ -->\n    <v-row dense>\n      <v-col cols=\"12\" md=\"6\">\n        <div class=\"hmi-card hmi-card--equal\">\n          <div class=\"hmi-card-title\">\n            <v-icon size=\"16\" class=\"mr-1\">mdi-script-text-outline</v-icon>{{ tr(\"scenario_mode\") }}\n          </div>\n          <div class=\"d-flex align-center gap-3 mt-3\">\n            <v-switch v-model=\"scenarioMode\" inset color=\"blue\" density=\"compact\" hide-details\n              :label=\"scenarioMode ? 'ВКЛ' : 'ВЫКЛ'\"></v-switch>\n            <v-select\n              v-model=\"selectedScenario\" :items=\"scenarioList\"\n              :label=\"tr('select_scenario')\" density=\"compact\" variant=\"outlined\"\n              hide-details :disabled=\"!scenarioMode\" class=\"flex-grow-1\"\n            ></v-select>\n          </div>\n        </div>\n      </v-col>\n\n      <v-col cols=\"12\" md=\"6\">\n        <div class=\"hmi-card hmi-card--equal\">\n          <div class=\"hmi-card-title\" style=\"cursor:pointer\" @click=\"srExpanded = !srExpanded\">\n            <v-icon size=\"16\" class=\"mr-1\">mdi-chip</v-icon>\n            {{ tr(\"plc_state\") }}\n            <v-chip\n              :color=\"current.sr_status.ok ? 'green' : 'red'\"\n              size=\"x-small\" variant=\"elevated\" class=\"ml-2\"\n            >\n              {{ current.sr_status.ok ? tr('no_errors') : tr('sr_fault') }}\n            </v-chip>\n            <v-spacer></v-spacer>\n            <v-icon size=\"16\" class=\"ml-1\">{{ srExpanded ? 'mdi-chevron-up' : 'mdi-chevron-down' }}</v-icon>\n          </div>\n          <div v-if=\"srExpanded\" class=\"mt-2\">\n            <div class=\"font-mono text-caption mb-1\">\n              <span class=\"text-medium-emphasis\">SR: </span>{{ current.sr }}\n              &nbsp;|&nbsp;\n              <span class=\"text-medium-emphasis\">{{ tr('amp_bits') }}: </span>{{ current.sr_status.amplifier_bits_0_3 }}\n            </div>\n            <div class=\"font-mono text-caption sr-binary mb-2\">{{ current.sr_status.binary }}</div>\n            <div v-if=\"current.sr_status.errors && current.sr_status.errors.length\">\n              <v-chip\n                v-for=\"(err, i) in current.sr_status.errors\" :key=\"i\"\n                color=\"red\" size=\"x-small\" variant=\"elevated\" class=\"mr-1\"\n              >{{ err }}</v-chip>\n            </div>\n            <span v-else class=\"text-caption\" style=\"color:#2e7d32\">{{ tr('no_errors') }}</span>\n          </div>\n        </div>\n      </v-col>\n    </v-row>\n\n  </v-container>\n</template>\n\n<script>\nexport default {\n  name: \"SpeedTab\",\n\n  data() {\n    return {\n      TICKS_HIGH: 262144000,\n      TICKS_LOW:  6553600,\n\n      resolution: \"high\",\n      language:   \"russian\",\n\n      resolutionSwitching: false,\n      resSnackbar: false,\n\n      moveInputMode: \"dms\",\n      moveTarget:  { deg: 0, min: 0, sec: 0 },\n      moveTargetDeg:   0,\n      moveTargetTicks: 0,\n\n      params: {\n        angular_velocity:     { deg: 0, min: 0, sec: 0 },\n        angular_acceleration: { deg: 0, min: 0, sec: 0 },\n        deceleration:         { deg: 0, min: 0, sec: 0 },\n      },\n\n      srExpanded: false,\n      scenarioMode: false,\n      selectedScenario: null,\n      scenarioList: [\"Scenario 1\", \"Scenario 2\", \"Scenario 3\"],\n\n      current: {\n        position: 0,\n        velocity: 0,\n        torque:   0,\n        so:       false,\n        mo:       false,\n        ms:       3,\n        af:       0,\n        remote_control_ok: true,\n        sp:  0,\n        ac:  0,\n        dc:  0,\n        tr1: 0,\n        sr:  0,\n        sr_status: {\n          raw:                0,\n          binary:             \"00000000000000000000000000000000\",\n          amplifier_bits_0_3: \"0000\",\n          ok:                 true,\n          errors:             [],\n        },\n      },\n\n      i18n: {\n        russian: {\n          angular_speed:        \"Угловая скорость\",\n          motor_control:        \"Управление двигателем\",\n          drive_status:         \"Состояние привода\",\n          encoder_resolution:   \"Разрешение энкодера\",\n          motion_parameters:    \"Параметры движения\",\n          current_motion:       \"Текущее состояние\",\n          move_command:         \"Команда движения\",\n          plc_state:            \"Диагностика SR\",\n          scenario_mode:        \"Работа по сценарию\",\n          select_scenario:      \"Выбор сценария\",\n          apply_parameters:     \"Применить SP / AC / DC\",\n          input_mode:           \"Единицы ввода\",\n          res_high:             \"Высокое\",\n          res_low:              \"Низкое\",\n          ticks_per_rev:        \"тик/об\",\n          ticks_per_deg:        \"тик/°\",\n          current_ticks_per_deg:\"Текущее разрешение\",\n          res_switching_warning:\"Смените разрешение только при выключенном двигателе (SO=0)\",\n          res_warning_title:    \"Смена разрешения невозможна\",\n          res_warning_body:     \"Выключите двигатель (МО=0) и дождитесь остановки (SO=0) перед сменой пар энкодера.\",\n          res_warning_close:    \"Закрыть\",\n          angular_velocity:     \"Скорость SP\",\n          angular_acceleration: \"Ускорение AC\",\n          deceleration:         \"Замедление DC\",\n          set_values:           \"Уставки привода\",\n          position:             \"Позиция\",\n          velocity:             \"Скорость\",\n          torque:               \"Момент\",\n          deg_label:            \"°\",\n          min_label:            \"′\",\n          sec_label:            \"″\",\n          motor_on:             \"ВКЛ\",\n          motor_off:            \"ВЫКЛ\",\n          ms0:                  \"В окне\",\n          ms1:                  \"Цель достигнута\",\n          ms2:                  \"В движении\",\n          ms3:                  \"Выключен\",\n          no_errors:            \"Ошибок нет\",\n          sr_fault:             \"Ошибка SR\",\n          amp_bits:             \"Биты 0–3\",\n        },\n        english: {\n          angular_speed:        \"Angular Speed\",\n          motor_control:        \"Motor Control\",\n          drive_status:         \"Drive Status\",\n          encoder_resolution:   \"Encoder Resolution\",\n          motion_parameters:    \"Motion Parameters\",\n          current_motion:       \"Current State\",\n          move_command:         \"Move Command\",\n          plc_state:            \"SR Diagnostics\",\n          scenario_mode:        \"Scenario Mode\",\n          select_scenario:      \"Select Scenario\",\n          apply_parameters:     \"Apply SP / AC / DC\",\n          input_mode:           \"Input Units\",\n          res_high:             \"High\",\n          res_low:              \"Low\",\n          ticks_per_rev:        \"ticks/rev\",\n          ticks_per_deg:        \"ticks/°\",\n          current_ticks_per_deg:\"Current resolution\",\n          res_switching_warning:\"Switch resolution only when motor is off (SO=0)\",\n          res_warning_title:    \"Cannot switch resolution\",\n          res_warning_body:     \"Turn off the motor (MO=0) and wait for it to stop (SO=0) before switching encoder pairs.\",\n          res_warning_close:    \"Close\",\n          angular_velocity:     \"Speed SP\",\n          angular_acceleration: \"Acceleration AC\",\n          deceleration:         \"Deceleration DC\",\n          set_values:           \"Drive Setpoints\",\n          position:             \"Position\",\n          velocity:             \"Velocity\",\n          torque:               \"Torque\",\n          deg_label:            \"°\",\n          min_label:            \"′\",\n          sec_label:            \"″\",\n          motor_on:             \"ON\",\n          motor_off:            \"OFF\",\n          ms0:                  \"In window\",\n          ms1:                  \"Target reached\",\n          ms2:                  \"Moving\",\n          ms3:                  \"Disabled\",\n          no_errors:            \"No errors\",\n          sr_fault:             \"SR Fault\",\n          amp_bits:             \"Bits 0–3\",\n        },\n      },\n    };\n  },\n\n  computed: {\n    ticksPerDeg() {\n      return this.resolution === \"high\"\n        ? this.TICKS_HIGH / 360\n        : this.TICKS_LOW / 360;\n    },\n    msLabel() {\n      return this.tr(\"ms\" + this.current.ms) || (\"MS=\" + this.current.ms);\n    },\n    msChipColor() {\n      if (this.current.ms === 0) return \"green\";\n      if (this.current.ms === 1) return \"orange\";\n      if (this.current.ms === 2) return \"blue\";\n      return \"grey-darken-1\";\n    },\n  },\n\n  methods: {\n    tr(key) {\n      var d = this.i18n[this.language] || this.i18n[\"russian\"];\n      return d[key] !== undefined ? d[key] : key;\n    },\n\n    dmsToTicks(dms) {\n      var total = (Number(dms.deg) || 0)\n                + (Number(dms.min) || 0) / 60\n                + (Number(dms.sec) || 0) / 3600;\n      return Math.round(total * this.ticksPerDeg);\n    },\n\n    ticksToDms(ticks) {\n      var totalArcsec = Math.round((ticks || 0) / this.ticksPerDeg * 3600);\n      var sign = totalArcsec < 0 ? -1 : 1;\n      var abs  = Math.abs(totalArcsec);\n      var d    = Math.floor(abs / 3600);\n      var m    = Math.floor((abs % 3600) / 60);\n      var s    = abs % 60;\n      return { deg: sign * d, min: m, sec: s };\n    },\n\n    formatDeg(ticks) {\n      var total = (ticks || 0) / this.ticksPerDeg;\n      var sign  = total < 0 ? \"-\" : \"\";\n      var abs   = Math.abs(total);\n      var d     = Math.floor(abs);\n      var mf    = (abs - d) * 60;\n      var m     = Math.floor(mf);\n      var s     = ((mf - m) * 60).toFixed(2);\n      return sign + d + \"\\u00b0\\u202f\" + m + \"\\u2032\\u202f\" + s + \"\\u2033\";\n    },\n\n    formatSpeed(v) {\n      return ((Number(v) || 0) / this.ticksPerDeg).toFixed(3) + \" °/с\";\n    },\n\n    formatAccel(v) {\n      return ((Number(v) || 0) / this.ticksPerDeg).toFixed(3) + \" °/с²\";\n    },\n\n    getMoveTargetTicks() {\n      if (this.moveInputMode === \"dms\") {\n        return this.dmsToTicks(this.moveTarget);\n      } else if (this.moveInputMode === \"deg\") {\n        return Math.round((this.moveTargetDeg || 0) * this.ticksPerDeg);\n      } else {\n        return Math.round(this.moveTargetTicks || 0);\n      }\n    },\n\n    driveInit() {\n      this.send({ topic: \"driveInit\", payload: null });\n    },\n\n    sendCmd(topic) {\n      this.send({ topic: topic, payload: null });\n    },\n\n    applyMotionParams() {\n      this.send({\n        topic: \"set_motion_params\",\n        payload: {\n          sp_ticks:   this.dmsToTicks(this.params.angular_velocity),\n          ac_ticks:   this.dmsToTicks(this.params.angular_acceleration),\n          dc_ticks:   this.dmsToTicks(this.params.deceleration),\n          jerk_ticks: 0,\n        },\n      });\n    },\n\n    sendAbsoluteMove() {\n      this.send({\n        topic: \"set_absolute_position\",\n        payload: {\n          ticks:    this.getMoveTargetTicks(),\n          sp_ticks: this.dmsToTicks(this.params.angular_velocity),\n          ac_ticks: this.dmsToTicks(this.params.angular_acceleration),\n          dc_ticks: this.dmsToTicks(this.params.deceleration),\n        },\n      });\n    },\n\n    sendRelativeMove() {\n      this.send({\n        topic: \"set_relative_position\",\n        payload: {\n          ticks:    this.getMoveTargetTicks(),\n          sp_ticks: this.dmsToTicks(this.params.angular_velocity),\n          ac_ticks: this.dmsToTicks(this.params.angular_acceleration),\n          dc_ticks: this.dmsToTicks(this.params.deceleration),\n        },\n      });\n    },\n\n    switchResolution(newRes) {\n      if (newRes === this.resolution) return;\n      if (this.current.mo || this.current.so) {\n        this.resolutionSwitching = true;\n        this.resSnackbar = true;\n        return;\n      }\n      this.resolutionSwitching = false;\n      this.resSnackbar = false;\n      this.resolution = newRes;\n      this.send({ topic: \"set_resolution\", payload: { resolution: newRes } });\n    },\n\n    applyDriveData(d) {\n      if (!d || typeof d !== \"object\") return;\n      var n = function(v) { return Number(v); };\n\n      if (d.position  !== undefined) this.current.position = n(d.position);\n      if (d.velocity  !== undefined) this.current.velocity = n(d.velocity);\n      if (d.torque    !== undefined) this.current.torque   = n(d.torque);\n      if (d.so        !== undefined) this.current.so       = !!d.so;\n      if (d.mo        !== undefined) this.current.mo       = !!d.mo;\n      if (d.ms        !== undefined) this.current.ms       = n(d.ms);\n      if (d.af        !== undefined) this.current.af       = n(d.af);\n      if (d.sp        !== undefined) this.current.sp       = n(d.sp);\n      if (d.ac        !== undefined) this.current.ac       = n(d.ac);\n      if (d.dc        !== undefined) this.current.dc       = n(d.dc);\n      if (d.tr1       !== undefined) this.current.tr1      = n(d.tr1);\n      if (d.sr        !== undefined) this.current.sr       = n(d.sr);\n      if (d.remote_control_ok !== undefined)\n        this.current.remote_control_ok = !!d.remote_control_ok;\n\n      if (d.sr_status && typeof d.sr_status === \"object\") {\n        this.current.sr_status = {\n          raw:                d.sr_status.raw !== undefined ? n(d.sr_status.raw) : 0,\n          binary:             d.sr_status.binary             || \"00000000000000000000000000000000\",\n          amplifier_bits_0_3: d.sr_status.amplifier_bits_0_3 || \"0000\",\n          ok:                 d.sr_status.ok  !== undefined ? !!d.sr_status.ok : true,\n          errors:             Array.isArray(d.sr_status.errors) ? d.sr_status.errors : [],\n        };\n      }\n\n      if (d.resolution === \"high\" || d.resolution === \"low\") {\n        this.resolution = d.resolution;\n      }\n\n      // Автозакрытие снэкбара когда MO=0 и SO=0\n      if (!this.current.mo && !this.current.so) {\n        this.resolutionSwitching = false;\n        this.resSnackbar = false;\n      }\n    },\n\n    applyMotionParamsFromPayload(d) {\n      if (!d || typeof d !== \"object\") return;\n      if (d.sp !== undefined) this.params.angular_velocity     = this.ticksToDms(Number(d.sp));\n      if (d.ac !== undefined) this.params.angular_acceleration = this.ticksToDms(Number(d.ac));\n      if (d.dc !== undefined) this.params.deceleration         = this.ticksToDms(Number(d.dc));\n    },\n\n    onReread(msg) {\n      var d = (msg.payload && typeof msg.payload === \"object\") ? msg.payload : msg;\n      this.applyDriveData(d);\n      this.applyMotionParamsFromPayload(d);\n    },\n\n    onPollData(msg) {\n      var d = (msg.payload && typeof msg.payload === \"object\") ? msg.payload : msg;\n      this.applyDriveData(d);\n    },\n\n    onSetMotionParams(msg) {\n      var d = (msg.payload && typeof msg.payload === \"object\") ? msg.payload : msg;\n      this.applyDriveData(d);\n      this.applyMotionParamsFromPayload(d);\n    },\n\n    onSetResolution(msg) {\n      var d = (msg.payload && typeof msg.payload === \"object\") ? msg.payload : msg;\n      if (d.resolution === \"high\" || d.resolution === \"low\") {\n        this.resolution = d.resolution;\n      }\n    },\n\n    handleIncoming(msg) {\n      if (!msg || !msg.topic) return;\n      switch (msg.topic) {\n        case \"reread\":            this.onReread(msg);          break;\n        case \"poll_data\":         this.onPollData(msg);        break;\n        case \"set_motion_params\": this.onSetMotionParams(msg); break;\n        case \"set_resolution\":    this.onSetResolution(msg);   break;\n        // Ответы на команды мотора — обновляем состояние привода\n        case \"motor_on\":\n        case \"motor_off\":\n        case \"drive_stop\":        this.onPollData(msg);        break;\n        default: break;\n      }\n    },\n  },\n\n  mounted() {\n    this.send({ topic: \"reread\", payload: null });\n    var self = this;\n    this.$socket.on(\"msg-input:\" + this.id, function(msg) {\n      try { self.handleIncoming(msg); } catch (e) { console.error(\"[SpeedTab]\", e); }\n    });\n  },\n};\n</script>\n\n<style scoped>\n.font-mono { font-family: \"JetBrains Mono\", \"Roboto Mono\", monospace; }\n.no-wrap   { white-space: nowrap; }\n\n.hmi-root {\n  background: #ffffff;\n  min-height: 100%;\n}\n\n.hmi-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.hmi-title {\n  font-size: 20px;\n  font-weight: 700;\n  letter-spacing: -0.3px;\n  color: #1a1a2e;\n}\n.resolution-chip { font-size: 11px !important; letter-spacing: 0; }\n\n.hmi-card {\n  background: #ffffff;\n  border-radius: 10px;\n  border: 1px solid #e0e3e8;\n  padding: 12px 14px;\n  height: 100%;\n  box-shadow: 0 1px 4px rgba(0,0,0,0.06);\n}\n.hmi-card-title {\n  font-size: 12px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.6px;\n  color: #546e7a;\n  display: flex;\n  align-items: center;\n  border-bottom: 1px solid #eceff1;\n  padding-bottom: 6px;\n  margin-bottom: 4px;\n}\n.hmi-card--equal { min-height: 88px; }\n\n/* ── Motor buttons ───────────────────────────────────────────── */\n.motor-btn-row {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 6px;\n}\n.motor-btn {\n  width: 100% !important;\n  min-width: 0 !important;\n  font-size: 12px !important;\n  font-weight: 600 !important;\n  color: white !important;\n  height: 38px !important;\n}\n\n/* ── Status indicators ───────────────────────────────────────── */\n.status-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 6px;\n  margin-top: 6px;\n}\n.status-indicator {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  border-radius: 8px;\n  padding: 6px 8px;\n  border: 1.5px solid transparent;\n}\n.si--on   { background: #e8f5e9; border-color: #a5d6a7; color: #1b5e20; }\n.si--off  { background: #f5f5f5; border-color: #bdbdbd; color: #616161; }\n.si--error{ background: #ffebee; border-color: #ef9a9a; color: #b71c1c; }\n.si--ms-0 { background: #e8f5e9; border-color: #a5d6a7; color: #1b5e20; }\n.si--ms-1 { background: #fff8e1; border-color: #ffe082; color: #e65100; }\n.si--ms-2 { background: #e3f2fd; border-color: #90caf9; color: #0d47a1; }\n.si--ms-3 { background: #f5f5f5; border-color: #bdbdbd; color: #616161; }\n.si-icon-wrap { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }\n.si-body  { display: flex; flex-direction: column; min-width: 0; }\n.si-label {\n  font-size: 9px; font-weight: 700; text-transform: uppercase;\n  letter-spacing: 0.5px; opacity: 0.65; line-height: 1;\n}\n.si-value { font-size: 11px; font-weight: 700; line-height: 1.3; white-space: nowrap; }\n\n/* ── Resolution ──────────────────────────────────────────────── */\n.res-option {\n  border: 2px solid #e0e3e8; border-radius: 8px; padding: 8px 14px;\n  cursor: pointer; transition: all 0.15s ease; background: #fafbfc; min-width: 200px;\n}\n.res-option:hover      { border-color: #90caf9; background: #f0f8ff; }\n.res-option--active    { border-color: #1976d2; background: #e3f2fd; }\n.res-option-label      { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #546e7a; margin-bottom: 2px; }\n.res-option-val        { font-size: 13px; font-weight: 700; color: #1a237e; }\n.res-option-sub        { font-size: 11px; color: #78909c; }\n.res-info              { text-align: right; }\n.res-ticks             { font-size: 16px; font-weight: 700; color: #1976d2; }\n\n/* ── Combined block layout ───────────────────────────────────── */\n\n/* Горизонтальная компоновка: левая и правая части */\n.combined-layout {\n  display: flex;\n  align-items: stretch;\n  gap: 0;\n}\n\n/* Левая часть — фиксированная ширина, содержит резолюцию */\n.combined-left {\n  flex: 0 0 auto;\n  padding-right: 16px;\n}\n\n/* Вертикальный разделитель */\n.combined-vdivider {\n  width: 1px;\n  background: #e0e3e8;\n  margin: 0 16px;\n  align-self: stretch;\n}\n\n/* Правая часть — занимает остаток */\n.combined-right {\n  flex: 1 1 0;\n  min-width: 0;\n}\n\n/* Подзаголовки секций */\n.combined-section-title {\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.6px;\n  color: #546e7a;\n  display: flex;\n  align-items: center;\n}\n\n/* Строка с карточками разрешения */\n.res-option-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.res-swap-icon { flex-shrink: 0; }\n\n/* Тик/° — главная цифра (большой текст) */\n.res-tpd {\n  font-size: 15px;\n  font-weight: 800;\n  color: #1a237e;\n  line-height: 1.2;\n}\n\n/* Тик/об — вторичная информация (маленький текст) */\n.res-tpr {\n  font-size: 10px;\n  color: #90a4ae;\n  margin-top: 2px;\n}\n\n/* ── Motion params ───────────────────────────────────────────── */\n.param-row { display: flex; flex-direction: column; gap: 2px; }\n.param-row-label { font-weight: 600; color: #546e7a; font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px; }\n.param-field { max-width: 72px; }\n.param-ticks-badge { background: #eceff1; border-radius: 4px; padding: 2px 6px; white-space: nowrap; color: #546e7a; }\n\n/* ── State grid ──────────────────────────────────────────────── */\n.state-grid  { display: flex; flex-direction: column; gap: 4px; }\n.state-row   { display: grid; grid-template-columns: 80px 1fr auto; align-items: center; gap: 4px; min-height: 24px; }\n.state-key   { font-size: 12px; font-weight: 600; color: #546e7a; }\n.state-val   { font-size: 14px; font-weight: 700; color: #1565c0; }\n.state-ticks { font-size: 10px; color: #90a4ae; }\n.state-section-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #90a4ae; margin-top: 2px; }\n\n/* ── Move command ────────────────────────────────────────────── */\n\n/*\n  Двухколоночная сетка: левый столбец — растягивается,\n  правый — фиксированная ширина кнопки.\n  Две строки: [переключатель | Move ABS] и [поле ввода | Move REL].\n  gap между строками задаёт вертикальный отступ между парами.\n*/\n.move-grid {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  grid-template-rows: auto auto;\n  row-gap: 10px;      /* одинаковый отступ между строками */\n  column-gap: 12px;   /* отступ между левым и правым столбцом */\n  align-items: center;\n}\n.move-grid-left  { min-width: 0; }\n.move-grid-right { display: flex; justify-content: flex-end; }\n\n.move-field { max-width: 90px; }\n\n/* Обе кнопки одинакового размера */\n.move-btn {\n  width: 148px !important;\n  height: 38px !important;\n  font-size: 13px !important;\n  font-weight: 600 !important;\n}\n\n/* ── SR binary ───────────────────────────────────────────────── */\n.sr-binary { display: block; word-break: break-all; font-size: 11px; background: #eceff1; border-radius: 4px; padding: 3px 6px; color: #455a64; }\n\n/* ── Gap utility ─────────────────────────────────────────────── */\n.gap-2 { gap: 8px; }\n.gap-3 { gap: 12px; }\n.gap-4 { gap: 16px; }\n\n/* ── Pulse hint ──────────────────────────────────────────────── */\n@keyframes btn-pulse {\n  0%   { box-shadow: 0 0 0 0 rgba(251,140,0,0.7); transform: scale(1); }\n  50%  { box-shadow: 0 0 0 8px rgba(251,140,0,0); transform: scale(1.04); }\n  100% { box-shadow: 0 0 0 0 rgba(251,140,0,0); transform: scale(1); }\n}\n.motor-btn--pulse {\n  animation: btn-pulse 1.2s ease-in-out infinite !important;\n  outline: 2px solid #fb8c00 !important;\n  outline-offset: 2px;\n}\n</style>",
        "storeOutMessages": true,
