    {
        "id": "919ad73d0499e421",
        "type": "ui-template",
        "z": "5bbcbebf6ff74a86",
        "g": "52568354c3badd48",
        "group": "0a0c9b6ad340284b",
        "page": "",
        "ui": "",
        "name": "BEP",
        "order": 1,
        "width": "8",
        "height": "14",
        "head": "",
        "format": "<template>\n  <v-container class=\"bep-root pa-2\" fluid>\n\n    <div class=\"bep-header mb-2\">\n      <div class=\"d-flex align-center flex-wrap\" style=\"gap:6px;\">\n        <h1 class=\"page-title\">{{ tr('title') }}</h1>\n        <v-chip :color=\"proc.running ? 'success' : 'error'\" variant=\"flat\" size=\"small\">\n          <v-icon start size=\"12\">{{ proc.running ? 'mdi-circle' : 'mdi-circle-outline' }}</v-icon>\n          {{ proc.running ? tr('proc_running') : tr('proc_stopped') }}\n        </v-chip>\n        <v-chip v-if=\"proc.uptime_s > 0\" color=\"blue-grey\" variant=\"outlined\" size=\"small\">\n          {{ tr('uptime') }}: {{ fmtUptime(proc.uptime_s) }}\n        </v-chip>\n        <v-chip v-if=\"proc.packets > 0\" color=\"blue-grey\" variant=\"outlined\" size=\"small\">\n          {{ tr('packets') }}: {{ proc.packets }}\n        </v-chip>\n      </div>\n      <v-alert v-if=\"proc.error_code\" type=\"error\" density=\"compact\" class=\"mt-1\" closable\n        @click:close=\"proc.error_code = ''\">\n        <strong>{{ proc.error_code }}</strong>: {{ proc.error_msg }}\n      </v-alert>\n      <v-alert v-if=\"execError\" type=\"warning\" density=\"compact\" class=\"mt-1\" closable @click:close=\"execError = ''\">\n        {{ execError }}\n      </v-alert>\n    </div>\n\n    <v-row class=\"mb-2\" dense>\n      <v-col cols=\"12\" md=\"4\">\n        <v-card class=\"dashboard-card pa-3 h-100\" elevation=\"0\" rounded=\"lg\">\n          <div class=\"sec-title mb-2\">\n            <v-icon size=\"14\" class=\"mr-1\">mdi-map-marker-radius</v-icon>\n            {{ tr('sensor_map') }}\n          </div>\n          <div class=\"d-flex justify-center align-center sensor-map-wrap\">\n            <svg viewBox=\"0 0 220 220\" class=\"sensor-map-svg\">\n              <circle cx=\"110\" cy=\"110\" r=\"100\" fill=\"#f8fbff\" stroke=\"#c7d3df\" stroke-width=\"2\" />\n              <circle cx=\"110\" cy=\"110\" r=\"72\" fill=\"none\" stroke=\"#dbe5ee\" stroke-width=\"1\" stroke-dasharray=\"4 3\" />\n              <circle cx=\"110\" cy=\"110\" r=\"50\" fill=\"#d7ebff\" stroke=\"#1976d2\" stroke-width=\"2\" />\n              <text x=\"110\" y=\"114\" text-anchor=\"middle\" font-size=\"9\" fill=\"#1565c0\" font-weight=\"bold\">шпиндель</text>\n\n              <g transform=\"translate(110,110) rotate(-135) translate(0,-82)\">\n                <rect x=\"-14\" y=\"-9\" width=\"28\" height=\"18\" rx=\"4\" :fill=\"sFill(0)\" stroke=\"white\" stroke-width=\"1\" />\n                <text x=\"0\" y=\"4\" text-anchor=\"middle\" font-size=\"8\" fill=\"white\" font-weight=\"bold\">{{ sAbbr(0) }}</text>\n              </g>\n              <g transform=\"translate(110,110) rotate(-45) translate(0,-82)\">\n                <rect x=\"-14\" y=\"-9\" width=\"28\" height=\"18\" rx=\"4\" :fill=\"sFill(1)\" stroke=\"white\" stroke-width=\"1\" />\n                <text x=\"0\" y=\"4\" text-anchor=\"middle\" font-size=\"8\" fill=\"white\" font-weight=\"bold\">{{ sAbbr(1) }}</text>\n              </g>\n              <g transform=\"translate(110,110) rotate(135) translate(0,-82)\">\n                <rect x=\"-14\" y=\"-9\" width=\"28\" height=\"18\" rx=\"4\" :fill=\"sFill(2)\" stroke=\"white\" stroke-width=\"1\" />\n                <text x=\"0\" y=\"4\" text-anchor=\"middle\" font-size=\"8\" fill=\"white\" font-weight=\"bold\">{{ sAbbr(2) }}</text>\n              </g>\n              <g transform=\"translate(110,110) rotate(45) translate(0,-82)\">\n                <rect x=\"-14\" y=\"-9\" width=\"28\" height=\"18\" rx=\"4\" :fill=\"sFill(3)\" stroke=\"white\" stroke-width=\"1\" />\n                <text x=\"0\" y=\"4\" text-anchor=\"middle\" font-size=\"8\" fill=\"white\" font-weight=\"bold\">{{ sAbbr(3) }}</text>\n              </g>\n              <rect x=\"190\" y=\"101\" width=\"28\" height=\"18\" rx=\"4\" :fill=\"sFill(4)\" stroke=\"white\" stroke-width=\"1\" />\n              <text x=\"204\" y=\"113\" text-anchor=\"middle\" font-size=\"8\" fill=\"white\" font-weight=\"bold\">{{ sAbbr(4) }}</text>\n              <line x1=\"188\" y1=\"110\" x2=\"162\" y2=\"110\" stroke=\"#bdbdbd\" stroke-width=\"1\" stroke-dasharray=\"3 2\" />\n              <text x=\"204\" y=\"128\" text-anchor=\"middle\" font-size=\"7\" fill=\"#9e9e9e\">ос.</text>\n\n              <text x=\"68\" y=\"90\" text-anchor=\"middle\" font-size=\"9\" fill=\"#424242\">{{ fmtShort(0) }}</text>\n              <text x=\"152\" y=\"90\" text-anchor=\"middle\" font-size=\"9\" fill=\"#424242\">{{ fmtShort(1) }}</text>\n              <text x=\"68\" y=\"136\" text-anchor=\"middle\" font-size=\"9\" fill=\"#424242\">{{ fmtShort(2) }}</text>\n              <text x=\"152\" y=\"136\" text-anchor=\"middle\" font-size=\"9\" fill=\"#424242\">{{ fmtShort(3) }}</text>\n            </svg>\n          </div>\n          <div class=\"legend-grid mt-1\">\n            <div v-for=\"(s, i) in localSensors\" :key=\"i\" class=\"legend-item\">\n              <span class=\"legend-dot\" :style=\"{ background: sFill(i) }\"></span>\n              <span class=\"legend-text\">{{ s.label }}: <strong>{{ fmtVal(i) }}</strong></span>\n            </div>\n          </div>\n        </v-card>\n      </v-col>\n\n      <v-col cols=\"12\" md=\"8\">\n        <v-card class=\"dashboard-card pa-3 h-100\" elevation=\"0\" rounded=\"lg\">\n          <div class=\"sec-title mb-2\">\n            <v-icon size=\"14\" class=\"mr-1\">mdi-chart-bar</v-icon>\n            {{ tr('chart_title') }}\n          </div>\n          <div class=\"chart-wrap\">\n            <canvas ref=\"barCanvas\"></canvas>\n          </div>\n        </v-card>\n      </v-col>\n    </v-row>\n\n    <div class=\"bottom-layout\">\n      <section class=\"dashboard-card bottom-card control-card\">\n        <div class=\"bottom-title\">\n          <span class=\"bottom-title__icon\">&#9881;</span>\n          <div class=\"sec-title\">{{ tr('control_title') }}</div>\n        </div>\n\n        <div class=\"control-section\">\n          <div class=\"field-lbl control-label\">{{ tr('process_ctrl') }}</div>\n          <div class=\"plain-grid\">\n            <button type=\"button\" class=\"plain-btn plain-btn--success\" :disabled=\"procStarting\" @click=\"startProcess\">\n              <span class=\"plain-btn__icon\">&#9654;</span>\n              <span class=\"plain-btn__text\">{{ tr('proc_start') }}</span>\n            </button>\n            <button type=\"button\" class=\"plain-btn plain-btn--danger\" @click=\"stopProcess\">\n              <span class=\"plain-btn__icon\">&#9632;</span>\n              <span class=\"plain-btn__text\">{{ tr('proc_stop') }}</span>\n            </button>\n            <button type=\"button\" class=\"plain-btn plain-btn--ghost plain-btn--wide\" @click=\"reloadCfg\">\n              <span class=\"plain-btn__icon\">&#8635;</span>\n              <span class=\"plain-btn__text\">{{ tr('reload_cfg') }}</span>\n            </button>\n          </div>\n        </div>\n\n        <div class=\"control-divider\"></div>\n\n        <div class=\"control-section\">\n          <div class=\"field-lbl control-label\">{{ tr('meas_ctrl') }}</div>\n          <div class=\"plain-grid\">\n            <button type=\"button\" class=\"plain-btn plain-btn--success\" @click=\"onStart\">\n              <span class=\"plain-btn__icon\">&#9654;</span>\n              <span class=\"plain-btn__text\">{{ tr('start') }}</span>\n            </button>\n            <button type=\"button\" class=\"plain-btn plain-btn--danger\" @click=\"onStop\">\n              <span class=\"plain-btn__icon\">&#9632;</span>\n              <span class=\"plain-btn__text\">{{ tr('stop') }}</span>\n            </button>\n            <button type=\"button\" class=\"plain-btn plain-btn--blue\" @click=\"onStartSingle\">\n              <span class=\"plain-btn__text\">{{ tr('start_single') }}</span>\n            </button>\n            <button type=\"button\" class=\"plain-btn plain-btn--purple\" @click=\"onStartCapdac\">\n              <span class=\"plain-btn__text\">{{ tr('start_capdac') }}</span>\n            </button>\n          </div>\n        </div>\n\n        <div class=\"control-divider\"></div>\n\n        <div class=\"control-section\">\n          <div class=\"field-lbl control-label\">{{ tr('board_settings') }}</div>\n          <div class=\"plain-grid\">\n            <input class=\"plain-input\" v-model.number=\"boardNum\" type=\"number\" :placeholder=\"tr('board_num')\" @change=\"boardChanged\">\n            <input class=\"plain-input\" v-model.number=\"capdacVal\" type=\"number\" :placeholder=\"tr('capdac_val')\" @change=\"capdacChanged\">\n          </div>\n        </div>\n      </section>\n\n      <section class=\"dashboard-card bottom-card bottom-card--config\">\n        <div class=\"config-headline\">\n          <div class=\"bottom-title bottom-title--compact\">\n            <span class=\"bottom-title__icon\">&#8801;</span>\n            <div class=\"sec-title\">{{ tr('sensor_cfg') }}</div>\n          </div>\n          <button type=\"button\" class=\"plain-btn plain-btn--primary plain-btn--save\" :disabled=\"savingConfig\" @click=\"saveConfig\">\n            <span class=\"plain-btn__icon\">&#9635;</span>\n            <span class=\"plain-btn__text\">{{ tr('save') }}</span>\n          </button>\n        </div>\n\n        <div class=\"cfg-head\">\n          <span>{{ tr('col_ch') }}</span>\n          <span>{{ tr('col_label') }}</span>\n          <span>{{ tr('col_canid') }}</span>\n          <span>{{ tr('col_pos') }}</span>\n          <span>{{ tr('col_on') }}</span>\n        </div>\n\n        <div v-for=\"(s, i) in localSensors\" :key=\"i\" class=\"cfg-row\">\n          <div class=\"cfg-cell cfg-cell--channel\">\n            <span class=\"ch-badge\" :style=\"{ background: sFill(i) }\">{{ s.channel }}</span>\n          </div>\n          <div class=\"cfg-field cfg-field--label\">\n            <input class=\"cfg-control\" v-model=\"s.label\" type=\"text\">\n          </div>\n          <div class=\"cfg-field cfg-field--can\">\n            <input class=\"cfg-control\" v-model.number=\"s.can_id\" type=\"number\">\n          </div>\n          <div class=\"cfg-field cfg-field--position\">\n            <select class=\"cfg-control cfg-select\" v-model=\"s.position\">\n              <option v-for=\"opt in positionOptions\" :key=\"opt.value\" :value=\"opt.value\">{{ opt.label }}</option>\n            </select>\n          </div>\n          <div class=\"cfg-cell cfg-cell--switch\">\n            <label class=\"cfg-switch\">\n              <input v-model=\"s.enabled\" type=\"checkbox\">\n              <span class=\"cfg-switch__track\"></span>\n              <span class=\"cfg-switch__thumb\"></span>\n            </label>\n          </div>\n        </div>\n\n        <div v-if=\"proc.unknown_can_ids && proc.unknown_can_ids.length\" class=\"cfg-note\">\n          <strong>{{ tr('unknown_ids') }}:</strong>\n          <span v-for=\"id in proc.unknown_can_ids\" :key=\"id\" class=\"ml-1 font-mono\">\n            0x{{ id.toString(16).toUpperCase() }} ({{ id }})\n          </span>\n          - {{ tr('add_to_cfg') }}\n        </div>\n      </section>\n    </div>\n\n  </v-container>\n</template>\n\n<script>\n  export default {\n  name: \"BepDashboard\",\n\n  data() {\n    return {\n      lang: \"russian\",\n      channels: [0, 0, 0, 0, 0],\n\n      localSensors: [\n        { can_id: 33, channel: 1, position: \"radial_top_left\", label: \"Рад. верх Л\", enabled: true },\n        { can_id: 34, channel: 2, position: \"radial_top_right\", label: \"Рад. верх П\", enabled: true },\n        { can_id: 35, channel: 3, position: \"radial_bot_left\", label: \"Рад. низ Л\", enabled: true },\n        { can_id: 36, channel: 4, position: \"radial_bot_right\", label: \"Рад. низ П\", enabled: true },\n        { can_id: 37, channel: 5, position: \"axial\", label: \"Осевой\", enabled: true },\n      ],\n\n      proc: {\n        ok: false, running: false, uptime_s: 0, packets: 0,\n        error_code: \"\", error_msg: \"\", unknown_can_ids: [], sensors: [],\n      },\n\n      boardNum: 33,\n      capdacVal: 0,\n      procStarting: false,\n      savingConfig: false,\n      execError: \"\",\n      chartResizeObserver: null,\n\n      colors: [\"#1976d2\", \"#0097a7\", \"#388e3c\", \"#7b1fa2\", \"#e64a19\"],\n\n      positionOptions: [\n        { value: \"radial_top_left\",  label: \"Рад. верх Л\" },\n        { value: \"radial_top_right\", label: \"Рад. верх П\" },\n        { value: \"radial_bot_left\",  label: \"Рад. низ Л\" },\n        { value: \"radial_bot_right\", label: \"Рад. низ П\" },\n        { value: \"axial\",            label: \"Осевой\" },\n      ],\n\n      i18nDict: {\n        russian: {\n          title: \"БЕП — Контроль зазора\",\n          proc_running: \"Запущен\", proc_stopped: \"Остановлен\",\n          proc_start: \"Запустить\", proc_stop: \"Остановить\",\n          reload_cfg: \"Перечитать конфиг\",\n          uptime: \"Аптайм\", packets: \"Пакетов\",\n          sensor_map: \"Схема датчиков\", chart_title: \"Показания каналов\",\n          control_title: \"Управление\",\n          process_ctrl: \"Процесс\", meas_ctrl: \"Измерения\",\n          board_settings: \"Параметры платы\",\n          sensor_cfg: \"Конфигурация датчиков\", save: \"Сохранить\",\n          col_ch: \"Кан.\", col_label: \"Название\", col_canid: \"CAN ID\",\n          col_pos: \"Позиция\", col_on: \"Вкл\",\n          start: \"Старт\", stop: \"Стоп\",\n          start_single: \"Старт (single)\", start_capdac: \"Старт (CAPDAC)\",\n          board_num: \"Номер платы\", capdac_val: \"Знач. CAPDAC\",\n          unknown_ids: \"Неизвестные CAN ID\", add_to_cfg: \"добавьте в конфиг\",\n        },\n        english: {\n          title: \"BEP — Gap Control\",\n          proc_running: \"Running\", proc_stopped: \"Stopped\",\n          proc_start: \"Start\", proc_stop: \"Stop\",\n          reload_cfg: \"Reload config\",\n          uptime: \"Uptime\", packets: \"Packets\",\n          sensor_map: \"Sensor Map\", chart_title: \"Channel Readings\",\n          control_title: \"Control\",\n          process_ctrl: \"Process\", meas_ctrl: \"Measurements\",\n          board_settings: \"Board Settings\",\n          sensor_cfg: \"Sensor Configuration\", save: \"Save\",\n          col_ch: \"Ch.\", col_label: \"Label\", col_canid: \"CAN ID\",\n          col_pos: \"Position\", col_on: \"On\",\n          start: \"Start\", stop: \"Stop\",\n          start_single: \"Start (single)\", start_capdac: \"Start (CAPDAC)\",\n          board_num: \"Board number\", capdac_val: \"CAPDAC value\",\n          unknown_ids: \"Unknown CAN IDs\", add_to_cfg: \"add to config\",\n        },\n      },\n    };\n  },\n\n  methods: {\n    tr(key) {\n      var d = this.i18nDict[this.lang] || this.i18nDict.russian;\n      return d[key] !== undefined ? d[key] : key;\n    },\n\n    fmtVal(idx) {\n      var v = this.channels[idx];\n      if (v === undefined || v === null || v === 0) return \"—\";\n      return Number(v).toLocaleString();\n    },\n    fmtShort(idx) {\n      var v = this.channels[idx];\n      if (!v) return \"\";\n      return Number(v).toLocaleString();\n    },\n    fmtUptime(secs) {\n      if (secs < 60) return secs + \"с\";\n      if (secs < 3600) return Math.floor(secs / 60) + \"м \" + (secs % 60) + \"с\";\n      return Math.floor(secs / 3600) + \"ч \" + Math.floor((secs % 3600) / 60) + \"м\";\n    },\n\n    sFill(idx) {\n      var s = this.localSensors[idx];\n      if (!s || !s.enabled) return \"#bdbdbd\";\n      return this.colors[idx % this.colors.length];\n    },\n    sAbbr(idx) {\n      var s = this.localSensors[idx];\n      if (!s) return \"?\";\n      var map = {\n        radial_top_left: \"ВЛ\", radial_top_right: \"ВП\",\n        radial_bot_left: \"НЛ\", radial_bot_right: \"НП\",\n        axial: \"ОС\",\n      };\n      return map[s.position] || String(s.channel);\n    },\n\n    _roundRect(ctx, x, y, w, h, r) {\n      ctx.beginPath();\n      ctx.moveTo(x + r, y);\n      ctx.lineTo(x + w - r, y);\n      ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n      ctx.lineTo(x + w, y + h - r);\n      ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n      ctx.lineTo(x + r, y + h);\n      ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n      ctx.lineTo(x, y + r);\n      ctx.quadraticCurveTo(x, y, x + r, y);\n      ctx.closePath();\n    },\n\n    drawBars() {\n      var canvas = this.$refs.barCanvas;\n      if (!canvas) return;\n      var ctx = canvas.getContext(\"2d\");\n      var dpr = window.devicePixelRatio || 1;\n      var rect = canvas.getBoundingClientRect();\n      if (!rect.width || !rect.height) return;\n      canvas.width = rect.width * dpr;\n      canvas.height = rect.height * dpr;\n      ctx.scale(dpr, dpr);\n      var W = rect.width, H = rect.height;\n      ctx.clearRect(0, 0, W, H);\n\n      var values = this.channels.map(function(v) {\n        return typeof v === \"number\" ? v : Number(v) || 0;\n      });\n      var maxVal = Math.max.apply(null, values);\n      if (maxVal === 0) maxVal = 1;\n\n      var pad = 30, chartW = W - pad * 2, chartH = H - pad * 2;\n      var n = values.length;\n      var gapW = 10;\n      var barW = (chartW - gapW * (n - 1)) / n;\n\n      ctx.strokeStyle = \"#eef3f7\";\n      ctx.lineWidth = 1;\n      for (var gi = 0; gi <= 4; gi++) {\n        var gy = pad + (chartH * gi) / 4;\n        ctx.beginPath();\n        ctx.moveTo(pad, gy);\n        ctx.lineTo(pad + chartW, gy);\n        ctx.stroke();\n        ctx.fillStyle = \"#8fa1b3\";\n        ctx.font = \"9px Roboto,Arial,sans-serif\";\n        ctx.textAlign = \"right\";\n        ctx.textBaseline = \"middle\";\n        ctx.fillText(Math.round(maxVal * (1 - gi / 4)).toLocaleString(), pad - 3, gy);\n      }\n\n      ctx.strokeStyle = \"#c7d3df\";\n      ctx.lineWidth = 1.5;\n      ctx.beginPath();\n      ctx.moveTo(pad, pad);\n      ctx.lineTo(pad, pad + chartH);\n      ctx.lineTo(pad + chartW, pad + chartH);\n      ctx.stroke();\n\n      for (var i = 0; i < n; i++) {\n        var val = values[i] || 0;\n        var barH = (val / maxVal) * chartH;\n        var x = pad + i * (barW + gapW);\n        var y = pad + chartH - barH;\n        var color = this.colors[i % this.colors.length];\n\n        var grd = ctx.createLinearGradient(x, y, x, y + barH);\n        grd.addColorStop(0, color + \"bb\");\n        grd.addColorStop(1, color);\n        ctx.fillStyle = grd;\n        this._roundRect(ctx, x, y, barW, barH, 3);\n        ctx.fill();\n\n        ctx.fillStyle = \"#1f2933\";\n        ctx.font = \"bold 9px Roboto,Arial,sans-serif\";\n        ctx.textAlign = \"center\";\n        ctx.textBaseline = \"bottom\";\n        ctx.fillText(val.toLocaleString(), x + barW / 2, y - 2);\n\n        var s = this.localSensors[i];\n        var lbl = s ? s.label.slice(0, 7) : (\"К\" + (i + 1));\n        ctx.fillStyle = \"#6b7c8f\";\n        ctx.font = \"8px Roboto,Arial,sans-serif\";\n        ctx.textBaseline = \"top\";\n        ctx.fillText(lbl, x + barW / 2, pad + chartH + 4);\n      }\n    },\n\n    onStart()       { this.send({ payload: \"run\",                                          topic: \"mqtt_cmd\" }); },\n    onStop()        { this.send({ payload: \"stop\",                                         topic: \"mqtt_cmd\" }); },\n    onStartSingle() { this.send({ payload: \"run one \" + this.boardNum,                     topic: \"mqtt_cmd\" }); },\n    onStartCapdac() { this.send({ payload: \"run one \" + this.boardNum + \" \" + this.capdacVal, topic: \"mqtt_cmd\" }); },\n    boardChanged()  { this.send({ topic: \"board_num\",  payload: this.boardNum  }); },\n    capdacChanged() { this.send({ topic: \"capdac_val\", payload: this.capdacVal }); },\n\n    startProcess() {\n      this.procStarting = true;\n      this.execError = \"\";\n      this.send({ topic: \"bep_process\", payload: \"start\" });\n      var self = this;\n      setTimeout(function() { self.procStarting = false; }, 5000);\n    },\n    stopProcess() { this.send({ topic: \"bep_process\", payload: \"stop\"   }); },\n    reloadCfg()   { this.send({ topic: \"bep_process\", payload: \"reload\" }); },\n\n    saveConfig() {\n      this.savingConfig = true;\n      var newCfg = {\n        version: 1,\n        udp_host: \"192.168.1.20\",\n        udp_port: 20001,\n        mqtt_host: \"localhost\",\n        mqtt_port: 1883,\n        status_interval_s: 3,\n        sensors: this.localSensors.map(function(s) {\n          return {\n            can_id: Number(s.can_id), channel: Number(s.channel),\n            position: s.position, label: s.label, enabled: !!s.enabled,\n          };\n        }),\n      };\n      this.send({ topic: \"bep_config_write\", payload: JSON.stringify(newCfg) });\n      var self = this;\n      setTimeout(function() { self.savingConfig = false; }, 2000);\n    },\n\n    handleMsg(msg) {\n      if (!msg || !msg.topic) return;\n\n      if (msg.language) {\n        this.lang = (msg.language === \"english\" || msg.language === \"en\") ? \"english\" : \"russian\";\n      }\n      if (msg.topic === \"init\" && msg.language) {\n        this.lang = (msg.language === \"english\" || msg.language === \"en\") ? \"english\" : \"russian\";\n        return;\n      }\n\n      if (typeof msg.topic === \"string\" && msg.topic.startsWith(\"Channel \")) {\n        var idx = parseInt(msg.topic.split(\" \")[1], 10) - 1;\n        if (!isNaN(idx) && idx >= 0 && idx < 5) {\n          this.channels.splice(idx, 1, Number(msg.payload));\n          this.drawBars();\n        }\n        return;\n      }\n\n      if (msg.topic === \"bep_status\") {\n        var raw = msg.payload;\n        var parsed = (typeof raw === \"string\") ? JSON.parse(raw) : raw;\n        var self = this;\n        Object.keys(parsed).forEach(function(k) {\n          if (k !== \"sensors\") { self.proc[k] = parsed[k]; }\n        });\n        if (parsed.sensors && parsed.sensors.length > 0) {\n          parsed.sensors.forEach(function(srv) {\n            var ch = Number(srv.channel) - 1;\n            if (ch >= 0 && ch < self.localSensors.length) {\n              if (self.localSensors[ch].can_id === srv.can_id) {\n                Object.assign(self.localSensors[ch], srv);\n              }\n            }\n          });\n        }\n        return;\n      }\n\n      if (msg.topic === \"bep_exec_stderr\" || msg.topic === \"bep_exec_error\") {\n        var txt = String(msg.payload || \"\").trim();\n        if (txt) this.execError = txt.slice(0, 400);\n        this.procStarting = false;\n        return;\n      }\n      if (msg.topic === \"bep_exec_stdout\") { this.procStarting = false; return; }\n      if (msg.topic === \"board_num\")  this.boardNum  = Number(msg.payload) || this.boardNum;\n      if (msg.topic === \"capdac_val\") this.capdacVal = Number(msg.payload) || this.capdacVal;\n    },\n  },\n\n  mounted() {\n    var self = this;\n    this.$nextTick(function() {\n      self.drawBars();\n      if (window.ResizeObserver) {\n        var canvas = self.$refs.barCanvas;\n        if (canvas && canvas.parentElement) {\n          self.chartResizeObserver = new ResizeObserver(function() { self.drawBars(); });\n          self.chartResizeObserver.observe(canvas.parentElement);\n        }\n      }\n    });\n    this.send({ topic: \"reread\" });\n    this.$socket.on(\"msg-input:\" + this.id, function(msg) {\n      try { self.handleMsg(msg); } catch (e) { /* ignore */ }\n    });\n  },\n\n  beforeDestroy() {\n    if (this.chartResizeObserver) this.chartResizeObserver.disconnect();\n  },\n};\n</script>\n\n<style scoped>\n  .bep-root {\n    background: #ffffff;\n    min-height: 100%;\n    color: #1f2933;\n  }\n\n  .dashboard-card {\n    background: #ffffff;\n    border: 1px solid #e5edf5;\n    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.06), 0 4px 10px rgba(15, 23, 42, 0.03);\n  }\n\n  .control-card {\n    /* убираем align-self: flex-start — пусть растягивается по высоте соседа */\n    width: 100%;\n  }\n\n  /* ── заголовок страницы ── */\n  .page-title {\n    font-size: 20px;\n    font-weight: 700;\n    color: #0d47a1;\n    letter-spacing: -0.3px;\n  }\n\n  .bep-header {\n    padding-bottom: 2px;\n  }\n\n  .sec-title {\n    font-size: 12px;\n    /* было 11px */\n    font-weight: 700;\n    color: #607d8b;\n    text-transform: uppercase;\n    letter-spacing: 0.8px;\n    display: flex;\n    align-items: center;\n  }\n\n  .field-lbl {\n    font-size: 11px;\n    font-weight: 700;\n    color: #78909c;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  /* ── схема датчиков — немного больше ── */\n  .sensor-map-wrap {\n    min-height: 178px;\n    /* было 158px */\n    border: 1px solid #edf2f7;\n    border-radius: 10px;\n    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);\n  }\n\n  .sensor-map-svg {\n    width: 164px;\n    /* было 152px */\n    height: 164px;\n  }\n\n  /* ── график — немного выше ── */\n  .chart-wrap {\n    width: 100%;\n    height: 218px;\n    /* было 192px */\n    border: 1px solid #e3edf7;\n    border-radius: 10px;\n    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);\n    overflow: hidden;\n  }\n\n  .chart-wrap canvas {\n    width: 100%;\n    height: 100%;\n    display: block;\n  }\n\n  /* ── легенда — шрифт чуть больше ── */\n  .legend-grid {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 4px 10px;\n  }\n\n  .legend-item {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    font-size: 11px;\n    /* было 10px */\n    color: #455a64;\n  }\n\n  .legend-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    flex-shrink: 0;\n  }\n\n  .legend-text {\n    line-height: 1.3;\n  }\n\n  /* ── нижняя секция ── */\n  .control-section {\n    display: block;\n    width: 100%;\n  }\n\n  .bottom-layout {\n    display: grid;\n    grid-template-columns: minmax(300px, 4fr) minmax(0, 8fr);\n    gap: 12px;\n    align-items: stretch;\n    /* было start — теперь обе карточки одинаковой высоты */\n  }\n\n  .bottom-card {\n    padding: 12px 14px;\n    /* одинаковые отступы для обеих карточек */\n    border-radius: 12px;\n    box-sizing: border-box;\n  }\n\n  .bottom-card--config {\n    min-width: 0;\n  }\n\n  /* заголовок нижних блоков — одинаковое расстояние сверху */\n  .bottom-title {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    min-height: 44px; /* ← равно высоте кнопки «Сохранить» */\n    margin-bottom: 10px;\n    padding-top: 0;\n  }\n  \n  .bottom-title--compact { margin-bottom: 0; }\n\n  .bottom-title__icon {\n    color: #607d8b;\n    font-size: 12px;\n    line-height: 1;\n  }\n\n  .control-label {\n    display: block;\n    margin-bottom: 6px;\n  }\n\n  .control-divider {\n    height: 1px;\n    margin: 8px 0;\n    background: #edf2f7;\n  }\n\n  /* ── кнопки ── */\n  .plain-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 8px;\n    align-items: center;\n    width: 100%;\n  }\n\n  .plain-btn {\n    appearance: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    width: 100%;\n    min-width: 0;\n    height: 44px;\n    min-height: 44px;\n    max-height: 44px;\n    padding: 0 10px;\n    box-sizing: border-box;\n    border: 1px solid transparent;\n    border-radius: 4px;\n    color: #ffffff;\n    font: inherit;\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: 0;\n    line-height: 42px;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    cursor: pointer;\n    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.16);\n    transition: transform 0.12s ease, box-shadow 0.12s ease, opacity 0.12s ease;\n  }\n\n  .plain-btn:hover {\n    transform: translateY(-1px);\n    box-shadow: 0 6px 12px rgba(15, 23, 42, 0.14);\n  }\n\n  .plain-btn:disabled {\n    opacity: 0.7;\n    cursor: default;\n    transform: none;\n  }\n\n  .plain-btn__icon {\n    flex: 0 0 auto;\n    font-size: 10px;\n    line-height: 1;\n  }\n\n  .plain-btn__text {\n    min-width: 0;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .plain-btn--wide {\n    grid-column: 1 / -1;\n  }\n\n  .plain-btn--success {\n    background: #a9db45;\n    color: #101010;\n  }\n\n  .plain-btn--danger {\n    background: #ff5252;\n  }\n\n  .plain-btn--blue {\n    background: #1976d2;\n  }\n\n  .plain-btn--purple {\n    background: #7b1fa2;\n  }\n\n  .plain-btn--primary {\n    background: #1098d5;\n  }\n\n  .plain-btn--ghost {\n    background: #ffffff;\n    color: #4d6678;\n    border-color: #7b96aa;\n    box-shadow: none;\n  }\n\n  /* ── поля ввода ── */\n  .plain-input {\n    width: 100%;\n    box-sizing: border-box;\n    height: 44px;\n    min-height: 44px;\n    max-height: 44px;\n    padding: 0 12px;\n    border: 1px solid #aeb8c2;\n    border-radius: 4px;\n    background: #ffffff;\n    color: #1f2933;\n    font: inherit;\n    font-size: 13px;\n    outline: none;\n  }\n\n  .plain-input:focus {\n    border-color: #039bd3;\n    box-shadow: 0 0 0 1px #039bd3;\n  }\n\n  /* ── конфигурация ── */\n  .plain-btn--save {\n    min-width: 120px;\n    max-width: 140px;\n  }\n\n  .config-headline {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    min-height: 44px; /* ← то же самое */\n    margin-bottom: 10px;\n  }\n\n  .cfg-head {\n    display: grid;\n    grid-template-columns: 48px minmax(160px, 1.35fr) minmax(80px, 0.7fr) minmax(140px, 1fr) 56px;\n    gap: 10px;\n    align-items: center;\n    font-size: 10px;\n    font-weight: 700;\n    color: #78909c;\n    text-transform: uppercase;\n    letter-spacing: 0.6px;\n    padding: 0 8px 6px;\n    margin-bottom: 4px;\n    border-bottom: 1px solid #edf2f7;\n  }\n\n  .cfg-row {\n    display: grid;\n    grid-template-columns: 48px minmax(160px, 1.35fr) minmax(80px, 0.7fr) minmax(140px, 1fr) 56px;\n    gap: 10px;\n    align-items: center;\n    padding: 4px 0;\n    margin-bottom: 4px;\n  }\n\n  .cfg-head>*,\n  .cfg-row>* {\n    min-width: 0;\n  }\n\n  .cfg-field {\n    min-width: 0;\n  }\n\n  .cfg-control {\n    width: 100%;\n    box-sizing: border-box;\n    height: 36px;\n    padding: 0 10px;\n    border: 1px solid #aeb8c2;\n    border-radius: 4px;\n    background: #ffffff;\n    color: #1f2933;\n    font: inherit;\n    font-size: 13px;\n    outline: none;\n    appearance: none;\n  }\n\n  .cfg-control:focus {\n    border-color: #039bd3;\n    box-shadow: 0 0 0 1px #039bd3;\n  }\n\n  .cfg-select {\n    padding-right: 32px;\n    background-image:\n      linear-gradient(45deg, transparent 50%, #7f8f9d 50%),\n      linear-gradient(135deg, #7f8f9d 50%, transparent 50%);\n    background-position: calc(100% - 16px) 50%, calc(100% - 10px) 50%;\n    background-size: 5px 5px, 5px 5px;\n    background-repeat: no-repeat;\n  }\n\n  .cfg-row+.cfg-row {\n    border-top: 1px solid #edf2f7;\n    padding-top: 6px;\n  }\n\n  .cfg-cell--channel {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .cfg-cell--switch {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* ── тоггл ── */\n  .cfg-switch {\n    position: relative;\n    display: inline-flex;\n    width: 40px;\n    height: 22px;\n  }\n\n  .cfg-switch input {\n    position: absolute;\n    inset: 0;\n    margin: 0;\n    opacity: 0;\n    cursor: pointer;\n  }\n\n  .cfg-switch__track {\n    position: absolute;\n    inset: 4px 0;\n    border-radius: 999px;\n    background: #b7c7d3;\n    transition: background 0.18s ease;\n  }\n\n  .cfg-switch__thumb {\n    position: absolute;\n    top: 2px;\n    left: 2px;\n    width: 18px;\n    height: 18px;\n    border-radius: 50%;\n    background: #7b8c98;\n    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.16);\n    transition: transform 0.18s ease, background 0.18s ease;\n  }\n\n  .cfg-switch input:checked~.cfg-switch__track {\n    background: #b6e1f4;\n  }\n\n  .cfg-switch input:checked~.cfg-switch__thumb {\n    transform: translateX(18px);\n    background: #1098d5;\n  }\n\n  /* ── прочее ── */\n  .cfg-note {\n    margin-top: 8px;\n    padding: 8px 10px;\n    border: 1px solid #d6e7f3;\n    border-radius: 8px;\n    background: #f5fbff;\n    color: #4a6676;\n    font-size: 12px;\n    line-height: 1.4;\n  }\n\n  .ch-badge {\n    width: 26px;\n    height: 26px;\n    border-radius: 50%;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: #ffffff;\n    font-size: 10px;\n    font-weight: 700;\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.12);\n  }\n\n  .font-mono {\n    font-family: monospace;\n  }\n\n  .h-100 {\n    height: 100%;\n  }\n\n  @media (max-width: 960px) {\n    .bottom-layout {\n      grid-template-columns: 1fr;\n    }\n\n    .cfg-head {\n      display: none;\n    }\n\n    .cfg-row {\n      grid-template-columns: 44px minmax(0, 1fr) minmax(0, 1fr);\n      grid-template-areas:\n        \"channel label    label\"\n        \"channel can      position\"\n        \"channel toggle   toggle\";\n      align-items: start;\n    }\n\n    .cfg-cell--channel {\n      grid-area: channel;\n      justify-content: flex-start;\n      padding-top: 4px;\n    }\n\n    .cfg-field--label {\n      grid-area: label;\n    }\n\n    .cfg-field--can {\n      grid-area: can;\n    }\n\n    .cfg-field--position {\n      grid-area: position;\n    }\n\n    .cfg-cell--switch {\n      grid-area: toggle;\n      justify-content: flex-start;\n      padding-left: 2px;\n    }\n  }\n\n  @media (max-width: 768px) {\n    .chart-wrap {\n      height: 170px;\n    }\n  }\n\n  @media (max-width: 600px) {\n    .plain-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .plain-btn--wide {\n      grid-column: auto;\n    }\n\n    .config-headline {\n      flex-direction: column;\n      align-items: stretch;\n    }\n\n    .plain-btn--save {\n      max-width: none;\n    }\n\n    .chart-wrap {\n      height: 150px;\n    }\n\n    .sensor-map-wrap {\n      min-height: 160px;\n    }\n\n    .sensor-map-svg {\n      width: 148px;\n      height: 148px;\n    }\n  }\n</style>",
