    {
        "id": "eaf769e5299c3ac2",
        "type": "function",
        "z": "5aa5c3258e2560f3",
        "name": "Form capdac string",
        "func": "\nvar board_num = global.get(\"board_num\"),\n    capdac_val = global.get(\"capdac_val\");\n\nmsg.board = board_num;\nmsg.capdac = capdac_val;\n\nmsg.payload += \"_\" + board_num + \"_\" + capdac_val;\nreturn msg;",
