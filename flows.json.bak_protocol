    {
        "id": "41260670c79e4f0b",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": "Get vars & save",
        "func": "//convert to numbers\nmsg.payload = msg.payload.split(' ').map(Number);\n//get number to display\nvar v1_inp = { payload: msg.payload[0] },\n    v1_out = { payload: msg.payload[1] },\n    v2_inp = { payload: msg.payload[2] },\n    v2_out = { payload: msg.payload[3] },\n    v1_gap_inp = { payload: msg.payload[4] },\n    v1_gap_out = { payload: msg.payload[5] },\n    v2_gap_inp = { payload: msg.payload[6] },\n    v2_gap_out = { payload: msg.payload[7] },\n    v3_gap_inp = { payload: msg.payload[8] },\n    v3_gap_out = { payload: msg.payload[9] },\n    v4_gap_inp = { payload: msg.payload[10] },\n    v4_gap_out = { payload: msg.payload[11] },\n    v5_gap_inp = { payload: msg.payload[12] },\n    v5_gap_out = { payload: msg.payload[13] },\n    use_calib  = { payload: msg.payload[14] };\n\n//save as flow context\nglobal.set([\"v1_inp\", \"v1_out\",\n          \"v2_inp\", \"v2_out\",\n          \"v1_gap_inp\", \"v1_gap_out\",\n          \"v2_gap_inp\", \"v2_gap_out\",\n          \"v3_gap_inp\", \"v3_gap_out\",\n          \"v4_gap_inp\", \"v4_gap_out\",\n          \"v5_gap_inp\", \"v5_gap_out\", \n          \"use_calib\"],\n          \n    [v1_inp, v1_out,\n     v2_inp, v2_out,\n        \n    v1_gap_inp, v1_gap_out,\n    v2_gap_inp, v2_gap_out,\n    v3_gap_inp, v3_gap_out,\n    v4_gap_inp, v4_gap_out,\n    v5_gap_inp, v5_gap_out,\n    use_calib\n        ]);\n\n\n   \nreturn [v1_inp, v1_out,\n        v2_inp, v2_out,\n        v1_gap_inp, v1_gap_out,\n        v2_gap_inp, v2_gap_out,\n        v3_gap_inp, v3_gap_out,\n        v4_gap_inp, v4_gap_out,\n        v5_gap_inp, v5_gap_out,\n        use_calib];",
        "outputs": 15,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 3400,
        "wires": [
