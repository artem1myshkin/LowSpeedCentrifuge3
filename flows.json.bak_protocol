    {
        "id": "bep_exec_stop",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "name": "build stop cmd",
        "func": "// Сначала пробуем MQTT graceful stop\nnode.send([{topic:'bep/control', payload:'stop'}]);\n// Через 2 сек — taskkill если PID известен\nvar pid = flow.get('bep_pid');\nif (pid) {\n    setTimeout(function(){\n        node.send([null, {payload: 'taskkill /PID ' + pid + ' /F', topic:'kill'}]);\n    }, 2000);\n}\nreturn null;",
        "outputs": 2,
        "x": 3860,
        "y": 1195,
        "wires": [
            [
                "bep_mqtt_ctrl_out"
            ],
            [
                "bep_exec_kill"
            ]
        ]
    },
