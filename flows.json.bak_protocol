    {
        "id": "5ea29a533f8321ea",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "g": "768318bb2b74ee44",
        "name": "function 7",
        "func": "// ─────────────────────────────────────────\n// DEBUG NODE \n// ─────────────────────────────────────────\n\nfunction cmdStr(cmd, value) {\n    if (value === undefined || value === null) return cmd;\n    return cmd + \"=\" + value;\n}\n\nfunction joinCmds() {\n    var cmds = Array.isArray(arguments[0]) ? arguments[0] : Array.prototype.slice.call(arguments);\n    return cmds.filter(Boolean).join(\";\");\n}\n\nvar topic = msg.topic;\nvar elmoCmd = null;\n\nswitch (topic) {\n\n    case \"SR\":\n        elmoCmd = \"SR[1];\";\n        break;\n\n    case \"MO\":\n        elmoCmd = \"MO;\";\n        break;\n\n    case \"SO\":\n        elmoCmd = \"SO;\";\n        break;\n\n    case \"AF\":\n        elmoCmd = \"AF;\";\n        break;\n\n    case \"MO_SET\":\n        elmoCmd = \"MO=1;\";\n        break;\n\n    case \"SO_SET\":\n        elmoCmd = \"SO=1;\";\n        break;\n\n    default:\n        node.warn(\"Неизвестный topic: \" + topic);\n        return null;\n}\n\nmsg.payload = elmoCmd;\nmsg.elmo_topic = topic;\n\nnode.log(\"[\" + topic + \"] → \" + elmoCmd);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1260,
        "y": 1640,
        "wires": [
            [
                "0d712ff2ce7feeee"
            ]
        ]
