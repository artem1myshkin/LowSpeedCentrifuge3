        "name": " BUN Calibration",
        "func": "var ch_in = global.get(\"v2_inp\"),\n    ch_out = global.get(\"v2_out\"),\n    calib_use = global.get(\"use_calib\");\n\nmsg.calib_use = calib_use;\n\nmsg.topic = \"bun_angle\";\n\nif (calib_use == 0) \n{\n    msg.ignore = 1;\n    return msg;\n\n}\n\nvar ch_diff = ch_in.payload - ch_out.payload;\n\nmsg.payload += ch_diff;\n\nreturn msg;\n\n\n\n\n",
