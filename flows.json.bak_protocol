    {
        "id": "bep_stdout_fn",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "name": "stdout handler",
        "func": "// Сохраняем PID при первом сообщении (spawn mode)\nif (msg.pid && !flow.get('bep_pid')) {\n    flow.set('bep_pid', msg.pid);\n    node.log('BEP PID: ' + msg.pid);\n}\n// Пересылаем stdout в UI\nmsg.topic = 'bep_exec_stdout';\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 4100,
        "y": 1060,
        "wires": [
            []
        ]
    },
    {
        "id": "bep_stderr_fn",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "name": "stderr handler",
        "func": "// stderr — отправляем в UI для отображения пользователю\nif (msg.payload && String(msg.payload).trim()) {\n    msg.topic = 'bep_exec_stderr';\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "x": 4100,
        "y": 1100,
        "wires": [
            []
        ]
    },
    {
        "id": "bep_exitcode_fn",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "name": "exit code handler",
        "func": "// Процесс завершился\nflow.set('bep_pid', null);\nvar code = msg.payload;\nif (code !== 0) {\n    msg.topic = 'bep_exec_stderr';\n    msg.payload = 'Процесс завершился с кодом ' + code + '. Проверьте bep.log.';\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "x": 4110,
        "y": 1140,
        "wires": [
            []
        ]
    },
