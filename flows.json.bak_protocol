    {
        "id": "cd1902e1e473a48c",
        "type": "ui-template",
        "z": "5bbcbebf6ff74a86",
        "group": "9a565b73f40e098f",
        "page": "",
        "ui": "",
        "name": "Мониторинг",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <v-container class=\"page-container\" fluid>\n    <h1 class=\"page-title\">Мониторинг системы</h1>\n\n    <v-row dense>\n      <!-- ====== Первая строка ====== -->\n      <v-col cols=\"12\" md=\"6\">\n        <!-- Угол наклона -->\n        <v-card class=\"section-card elevation-3\">\n          <div class=\"section-header blue-gradient\">\n            <v-icon color=\"white\" class=\"mr-2\">mdi-axis-z-rotate-counterclockwise</v-icon>\n            <span>Угол наклона</span>\n          </div>\n\n          <v-row class=\"px-4 pt-4 pb-2\" dense>\n            <v-col cols=\"12\" v-for=\"(param, i) in tiltParams\" :key=\"i\">\n              <v-card class=\"param-card pa-3 elevation-0\">\n                <div class=\"d-flex align-center\">\n                  <v-icon v-if=\"param.icon\" color=\"#1976d2\" class=\"mr-2\">{{ param.icon }}</v-icon>\n                  <div>\n                    <div class=\"param-title\">{{ param.label }}</div>\n                    <div class=\"param-value\">\n                      {{ param.isAngle ? formatAngle(param.value) : param.value }}\n                    </div>\n                    <div v-if=\"param.note\" class=\"param-note\">{{ param.note }}</div>\n                  </div>\n                </div>\n              </v-card>\n            </v-col>\n\n            <v-col cols=\"12\">\n              <v-card class=\"status-card elevation-0\" :class=\"uun.ok ? 'status-ok' : 'status-error'\">\n                <v-icon size=\"26\">{{ uun.ok ? 'mdi-check-circle' : 'mdi-alert-circle' }}</v-icon>\n                <span class=\"status-label\">{{ uun.message }}</span>\n              </v-card>\n            </v-col>\n          </v-row>\n        </v-card>\n      </v-col>\n\n      <v-col cols=\"12\" md=\"6\">\n        <!-- Угловая скорость -->\n        <v-card class=\"section-card elevation-3\">\n          <div class=\"section-header cyan-gradient\">\n            <v-icon color=\"white\" class=\"mr-2\">mdi-rotate-orbit</v-icon>\n            <span>Угловая скорость</span>\n          </div>\n\n          <v-row class=\"px-4 pt-4 pb-2\" dense>\n            <v-col cols=\"12\" v-for=\"(param, i) in rotationParams\" :key=\"i\">\n              <v-card class=\"param-card pa-3 elevation-0\">\n                <div class=\"d-flex align-center\">\n                  <v-icon v-if=\"param.icon\" color=\"#1976d2\" class=\"mr-2\">{{ param.icon }}</v-icon>\n                  <div>\n                    <div class=\"param-title\">{{ param.label }}</div>\n                    <div class=\"param-value\">\n                      {{ param.isAngle ? formatAngle(param.value) : param.value }}\n                    </div>\n                    <div v-if=\"param.note\" class=\"param-note\">{{ param.note }}</div>\n                  </div>\n                </div>\n              </v-card>\n            </v-col>\n\n            <v-col cols=\"12\">\n              <v-card class=\"status-card elevation-0\" :class=\"uuv.ok ? 'status-ok' : 'status-error'\">\n                <v-icon size=\"26\">{{ uuv.ok ? 'mdi-check-circle' : 'mdi-alert-circle' }}</v-icon>\n                <span class=\"status-label\">{{ uuv.message }}</span>\n              </v-card>\n            </v-col>\n          </v-row>\n        </v-card>\n      </v-col>\n\n      <!-- ====== Вторая строка ====== -->\n      <v-col cols=\"12\" md=\"6\">\n        <!-- БЕП -->\n        <v-card class=\"section-card elevation-3\">\n          <div class=\"section-header purple-gradient\">\n            <v-icon color=\"white\" class=\"mr-2\">mdi-memory</v-icon>\n            <span>БЕП</span>\n          </div>\n\n          <v-row class=\"px-4 pt-4 pb-2\" dense>\n            <v-col cols=\"6\" sm=\"4\" md=\"6\" v-for=\"(sensor, i) in bepSensors\" :key=\"i\">\n              <v-card class=\"sensor-card pa-3 elevation-0 text-center\">\n                <div class=\"sensor-label\">Датчик {{ i + 1 }}</div>\n                <div class=\"sensor-value mt-2\">{{ sensor }} нм</div>\n              </v-card>\n            </v-col>\n\n            <v-col cols=\"12\">\n              <v-card class=\"status-card elevation-0\" :class=\"bep.ok ? 'status-ok' : 'status-error'\">\n                <v-icon size=\"26\">{{ bep.ok ? 'mdi-check-circle' : 'mdi-alert-circle' }}</v-icon>\n                <span class=\"status-label\">БЕП — {{ bep.ok ? 'Готов' : 'Ошибка' }}</span>\n              </v-card>\n            </v-col>\n          </v-row>\n        </v-card>\n      </v-col>\n\n      <v-col cols=\"12\" md=\"6\">\n        <!-- Другие параметры -->\n        <v-card class=\"section-card elevation-3\">\n          <div class=\"section-header teal-gradient\">\n            <v-icon color=\"white\" class=\"mr-2\">mdi-tools</v-icon>\n            <span>Другие параметры</span>\n          </div>\n\n          <v-row class=\"px-4 pt-4 pb-2\" dense>\n            <v-col cols=\"12\" v-for=\"(param, i) in otherParams\" :key=\"i\">\n              <v-card class=\"param-card pa-3 elevation-0\">\n                <div class=\"d-flex align-center\">\n                  <v-icon v-if=\"param.icon\" color=\"#1976d2\" class=\"mr-2\">{{ param.icon }}</v-icon>\n                  <div>\n                    <div class=\"param-title\">{{ param.label }}</div>\n                    <div class=\"param-value\">{{ param.value }}</div>\n                    <div v-if=\"param.note\" class=\"param-note\">{{ param.note }}</div>\n                  </div>\n                </div>\n              </v-card>\n            </v-col>\n          </v-row>\n\n          <v-row class=\"px-4 pb-4\" dense>\n            <v-col cols=\"6\" sm=\"6\" v-for=\"(status, i) in otherStatuses\" :key=\"i\">\n              <v-card class=\"status-card elevation-0\" :class=\"status.ok ? 'status-ok' : 'status-error'\">\n                <v-icon size=\"26\">{{ status.ok ? 'mdi-check-circle' : 'mdi-alert-circle' }}</v-icon>\n                <span class=\"status-label\">{{ status.label }} — {{ status.ok ? 'Готов' : 'Ошибка' }}</span>\n              </v-card>\n            </v-col>\n          </v-row>\n        </v-card>\n      </v-col>\n    </v-row>\n  </v-container>\n</template>\n\n<script>\n  export default {\n  name: 'MonitoringTab',\n  data() {\n    return {\n      tiltParams: [\n        { label: 'Заданный угол наклона', value: 12.5, isAngle: true, note: 'Установленный оператором' },\n        { label: 'Текущий угол наклона', value: 10.2, isAngle: true, note: 'Реальное положение оси' },\n        { label: 'Положение пневмотормоза', value: 'Закрыт', icon: 'mdi-brake-alert', note: 'Состояние тормоза' }\n      ],\n      rotationParams: [\n        { label: 'Заданная угловая скорость', value: 45.25, isAngle: true, note: 'Целевая скорость (°/с)' },\n        { label: 'Текущая угловая скорость', value: 44.83, isAngle: true, note: 'Фактическая скорость (°/с)' },\n        { label: 'Текущий угол поворота', value: 132.75, isAngle: true, note: 'Положение оси' }\n      ],\n      bepSensors: [123, 128, 130, 127, 125],\n      bep: { ok: true },\n      otherParams: [\n        { label: 'Датчик давления', value: '101.3 кПа', icon: 'mdi-gauge', note: 'Давление в системе' },\n        { label: 'Момент двигателя оси', value: '12 Н·м', note: 'Крутящий момент' }\n      ],\n      otherStatuses: [\n        { label: 'АПК', ok: true },\n        { label: 'Давление', ok: true }\n      ]\n    };\n  },\n  computed: {\n    uun() {\n      const zad = this.tiltParams[0].value;\n      const tek = this.tiltParams[1].value;\n      const ok = Math.abs(zad - tek) < 0.1;\n      return { ok, message: `УУН — ${ok ? 'угол наклона достигнут' : 'в процессе'}` };\n    },\n    uuv() {\n      const zad = this.rotationParams[0].value;\n      const tek = this.rotationParams[1].value;\n      const ok = Math.abs(zad - tek) < 0.1;\n      return { ok, message: `УУВ — ${ok ? 'угловая скорость достигнута' : 'в процессе'}` };\n    }\n  },\n  methods: {\n    formatAngle(value) {\n      if (typeof value !== 'number') return value;\n      const deg = Math.floor(value);\n      const minutesFull = (value - deg) * 60;\n      const min = Math.floor(minutesFull);\n      const sec = Math.round((minutesFull - min) * 60);\n      return `${deg}° ${min}′ ${sec}″`;\n    }\n  }\n};\n</script>\n\n<style scoped>\n  .page-container {\n    background: #f4f6f9;\n    min-height: 100vh;\n    padding: 24px;\n  }\n\n  .page-title {\n    font-size: 26px;\n    font-weight: 700;\n    color: #1a237e;\n    margin-bottom: 30px;\n    text-align: center;\n  }\n\n  .section-card {\n    border-radius: 18px;\n    overflow: hidden;\n    background: #fff;\n    margin-bottom: 30px;\n  }\n\n  .section-header {\n    display: flex;\n    align-items: center;\n    color: white;\n    font-weight: 700;\n    font-size: 18px;\n    padding: 10px 16px;\n    border-bottom: 2px solid rgba(255, 255, 255, 0.2);\n  }\n\n  .blue-gradient {\n    background: linear-gradient(90deg, #1565c0, #1976d2);\n  }\n\n  .cyan-gradient {\n    background: linear-gradient(90deg, #00838f, #00acc1);\n  }\n\n  .purple-gradient {\n    background: linear-gradient(90deg, #6a1b9a, #8e24aa);\n  }\n\n  .teal-gradient {\n    background: linear-gradient(90deg, #00796b, #009688);\n  }\n\n  .param-card {\n    background: #fafafa;\n    border-radius: 12px;\n    border: 1px solid #e0e0e0;\n    transition: 0.2s;\n  }\n\n  .param-card:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 2px 8px rgba(25, 118, 210, 0.15);\n  }\n\n  .param-title {\n    font-weight: 600;\n    font-size: 15px;\n    color: #37474f;\n  }\n\n  .param-value {\n    font-weight: 700;\n    font-size: 18px;\n    color: #1565c0;\n  }\n\n  .param-note {\n    font-size: 13px;\n    color: #666;\n  }\n\n  .sensor-card {\n    background: #f9f9f9;\n    border: 1px solid #ddd;\n    border-radius: 12px;\n  }\n\n  .sensor-label {\n    font-weight: 600;\n    font-size: 14px;\n    color: #424242;\n  }\n\n  .sensor-value {\n    font-size: 16px;\n    font-weight: 700;\n    color: #1976d2;\n  }\n\n  .status-card {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    border-radius: 12px;\n    padding: 10px 16px;\n    transition: 0.2s;\n    font-weight: 600;\n  }\n\n  .status-ok {\n    background-color: #e8f5e9;\n    color: #2e7d32;\n  }\n\n  .status-error {\n    background-color: #ffebee;\n    color: #c62828;\n  }\n\n  .status-card:hover {\n    transform: scale(1.02);\n  }\n</style>",
