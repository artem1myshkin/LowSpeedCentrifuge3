        "name": "Counter increment",
        "func": "\nvar gap_counter = context.get(\"gap_counter\") || 0;\n\ngap_counter += 1;\n\nmsg.payload = gap_counter;\n\ncontext.set(\"gap_counter\", gap_counter);\n\n\nreturn msg;",
