    {
        "id": "31303ca4dcfa6991",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": "function 1",
        "func": "\nif(msg.payload[0] == '0')\n{\n    msg.payload = \"IDLE (0)\";\n}\nelse if(msg.payload[0] == '1') {\n    msg.payload = \"ABS_POS (1)\";\n}\nelse if (msg.payload[0] == '2') {\n    msg.payload = \"REL_POS (2)\";\n}\nelse if (msg.payload[0] == '3') {\n    msg.payload = \"VELOCITY (3)\";\n}\nelse if (msg.payload[0] == '4') {\n    msg.payload = \"STOP (4)\";\n}\nelse if (msg.payload[0] == '5') {\n    msg.payload = \"HOME (5)\";\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,
        "y": 2620,
        "wires": [
            [
                "1fb3b0533ffd4f8e"
            ]
        ]
    },
