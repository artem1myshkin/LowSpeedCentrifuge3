        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n    <v-container class=\"containter\">\n        <h1 class=\"mt-2 ml-2 mb-6\">Журнал / Протокол</h1>\n        <v-card class=\"elevation-4 pa-4\">\n            <v-row>\n                <v-col cols=\"12\">\n                    <v-btn class=\"custom-btn-edit mr-2\" @click=\"openLog\">Открыть протокол</v-btn>\n                    <v-btn class=\"custom-btn-apply mr-2\" @click=\"exportLog\">Экспорт</v-btn>\n                </v-col>\n            </v-row>\n            <v-simple-table class=\"mt-6\">\n                <thead>\n                    <tr>\n                        <th>Дата/время</th>\n                        <th>Событие</th>\n                        <th>Тип</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr v-for=\"(log, index) in logs\" :key=\"index\">\n                        <td>{{ log.time }}</td>\n                        <td>{{ log.message }}</td>\n                        <td>{{ log.type }}</td>\n                    </tr>\n                </tbody>\n            </v-simple-table>\n        </v-card>\n    </v-container>\n</template>\n\n<script>\n    export default {\n  name: 'LogsTab',\n  data() {\n    return {\n      logs: []\n    };\n  },\n  methods: {\n    openLog() {},\n    exportLog() {}\n  }\n};\n</script>\n\n<style scoped>\n    .title-top {\n    font-size: 18px;\n    }\n    \n    .custom-btn-r {\n    background: #1394FF;\n    width: 120px;\n    height: 50px;\n    font-size: 18px;\n    color: #ffffff;\n    border-radius: 8px;\n    }\n    \n    .custom-btn-p {\n    background: #FF9402;\n    width: 120px;\n    height: 50px;\n    font-size: 18px;\n    color: #ffffff;\n    border-radius: 8px;\n    }\n    \n    .custom-btn-s {\n    background: #FF3040;\n    width: 120px;\n    height: 50px;\n    font-size: 18px;\n    color: #ffffff;\n    border-radius: 8px;\n    }\n    \n    .custom-btn-edit {\n    background: #1394FF;\n    width: 140px;\n    height: 20px;\n    font-size: 14px;\n    color: #ffffff;\n    border-radius: 5px;\n    }\n    \n    .custom-btn-delete {\n    background: #FF4040;\n    width: 90px;\n    height: 50px;\n    font-size: 14px;\n    color: #ffffff;\n    border-radius: 5px;\n    }\n    \n    .custom-btn-add {\n    background: #1394FF;\n    font-size: 16px;\n    color: #ffffff;\n    padding: 5px 15px 5px 15px;\n    border-radius: 5px;\n    }\n    \n    .custom-btn-apply {\n    background: #49C514;\n    font-size: 16px;\n    color: #ffffff;\n    padding: 5px 15px 5px 15px;\n    border-radius: 5px;\n    }\n    \n    .v-card {\n    border-radius: 12px;\n    background-color: #fafafa;\n    }\n    \n    .containter {\n    display: flex;\n    flex-direction: column;\n    gap: 30px;\n    margin: 20px;\n    }\n</style>",
