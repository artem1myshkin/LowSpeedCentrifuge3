    {
        "id": "90521671a9898340",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "name": "function 3",
        "func": "msg.payload = \"PX\\r\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 3140,
        "y": 2120,
        "wires": [
            [
                "964d1c19ad1c3e04"
            ]
        ]
    },
    {
        "id": "6d3285cef231e3ae",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "g": "768318bb2b74ee44",
        "name": "CommandHandler",
        "func": "// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║  Входящие топики (от Vue UI):                                            ║\n// ║   \"reread\"               — опрос PX,VX,MS,MO,SO,AF,SR,SP,AC,DC,        ║\n// ║                            TR[1],OL[1]                                   ║\n// ║   \"set_motion_params\"    — задать SP, AC, DC (сохраняет в flow context) ║\n// ║   \"motor_on\"             — MO=1                                          ║\n// ║   \"motor_off\"            — MO=0                                          ║\n// ║   \"drive_stop\"           — ST (быстрая остановка)                        ║\n// ║   \"drive_bg\"             — BG (начать выполнение)                        ║\n// ║   \"driveInit\"            — инициализация привода: настройка ДУ, MO=1,     ║\n// ║                            один оборот для инициализации сумматора DSi    ║\n// ║   \"drive_home\"           — HM[1]=1 (поиск нулевой метки)                ║\n// ║   \"set_absolute_position\"— SP=<sp>;AC=<ac>;DC=<dc>;PA=<ticks>;BG        ║\n// ║   \"set_relative_position\"— SP=<sp>;AC=<ac>;DC=<dc>;PR=<ticks>;BG        ║\n// ║   \"set_velocity\"         — AC=<ac>;DC=<dc>;JV=<ticks>;BG               ║\n// ║   \"set_resolution\"       — переключение пар головок ДУ согласно         ║\n// ║                            мануалу раздел 4 (только при SO=0)           ║\n// ║                                                                          ║\n// ║  SP/AC/DC для PA и PR берутся из flow.context(\"motion_params\"),         ║\n// ║  куда они сохраняются при каждом \"set_motion_params\".                   ║\n// ║  Дефолтные значения зависят от текущего разрешения (flow \"resolution\"). ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n\n// ──────────────────────────────────────────────────────────────────────────\n// Утилиты\n// ──────────────────────────────────────────────────────────────────────────\n\nfunction cmdStr(cmd, value) {\n    if (value === undefined || value === null) return cmd;\n    return cmd + \"=\" + value;\n}\n\nfunction joinCmds() {\n    var cmds = Array.isArray(arguments[0]) ? arguments[0] : Array.prototype.slice.call(arguments);\n    return cmds.filter(Boolean).join(\";\");\n}\n\nfunction resolutionSetupCmds(r) {\n    return [\n        cmdStr(\"OL[1]\", r.ol1),\n        cmdStr(\"CA[18]\", r.ca18),\n        cmdStr(\"S1[5]\", r.s1_5),\n        cmdStr(\"KP[2]\", r.kp2),\n        cmdStr(\"SD\", r.sd),\n        cmdStr(\"QS\", r.qs),\n        cmdStr(\"VH[1]\", r.vh1),\n        cmdStr(\"VL[1]\", r.vl1),\n        cmdStr(\"VH[2]\", r.vh2),\n        cmdStr(\"ER[3]\", r.er3),\n        cmdStr(\"ER[2]\", r.er2),\n        cmdStr(\"TR[1]\", r.tr1),\n        cmdStr(\"TR[3]\", r.tr3),\n    ];\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Константы разрешений (мануал, раздел 4, таблица 4.1)\n// ──────────────────────────────────────────────────────────────────────────\n\nvar RES = {\n    high: {\n        ol1: 0,\n        ca18: 262144000,\n        s1_5: 50000000,\n        kp2: 1e-6,\n        sd: 131072000,   // 180 °/с²\n        qs: 131072000,\n        vh1: 131072000,\n        vl1: 131072000,\n        vh2: 3640888,     // макс. скорость ~5 °/с\n        er3: 131072000,   // окно ошибки позиции 180°\n        er2: 131072000,   // окно ошибки скорости\n        tr1: 7282,        // окно позиции 0.01°\n        tr3: 364089,      // окно скорости 0.5°/с\n        sp_def: 728177,      // 1 °/с\n        ac_def: 364088,      // 0.5 °/с²\n    },\n    low: {\n        ol1: 1,\n        ca18: 6553600,\n        s1_5: 7662835,\n        kp2: 1e-5,\n        sd: 3276800,     // 180 °/с²\n        qs: 3276800,\n        vh1: 3276800,\n        vl1: 3276800,\n        vh2: 6553600,     // макс. скорость\n        er3: 3276800,\n        er2: 3276800,\n        tr1: 182,         // окно позиции 0.01°\n        tr3: 9102,        // окно скорости 0.5°/с\n        sp_def: 18204,       // 1 °/с\n        ac_def: 9102,        // 0.5 °/с²\n    },\n};\n\n// ──────────────────────────────────────────────────────────────────────────\n// Текущее разрешение и параметры движения из flow context\n// ──────────────────────────────────────────────────────────────────────────\n\nvar currentRes = flow.get(\"resolution\") || \"high\";\nvar resParams = RES[currentRes] || RES[\"high\"];\n\nvar storedParams = flow.get(\"motion_params\") || {\n    sp: resParams.sp_def,\n    ac: resParams.ac_def,\n    dc: resParams.ac_def,\n};\n\n// ──────────────────────────────────────────────────────────────────────────\n// Маршрутизация\n// ──────────────────────────────────────────────────────────────────────────\n\nvar topic = msg.topic;\nvar payload = msg.payload;\nvar elmoCmd = null;\n\nswitch (topic) {\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"reread\" — опрос текущего состояния привода\n    // Добавлен OL[1] для чтения текущего разрешения головок ДУ\n    // ────────────────────────────────────────────────────────────────────\n    case \"reread\":\n        elmoCmd = joinCmds(\n            \"OL[1]\\r\",\n            \"TR[1]\\r\",\n            \"AF\\r\",\n            \"SR\\r\",\n            \"MO\\r\",\n            \"SO\\r\",\n            \"PX\\r\",\n            \"VX\\r\",\n            \"SP\\r\",\n            \"AC\\r\",\n            \"DC\\r\"\n        );\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"set_motion_params\" — задать SP, AC, DC\n    // payload: { sp_ticks, ac_ticks, dc_ticks, jerk_ticks (опц.) }\n    // jerk_ticks игнорируется (Elmo не имеет команды jerk напрямую)\n    // ────────────────────────────────────────────────────────────────────\n    case \"set_motion_params\":\n        if (!payload) { node.warn(\"set_motion_params: нет payload\"); return null; }\n\n        var sp = Math.round(payload.sp_ticks || resParams.sp_def);\n        var ac = Math.round(payload.ac_ticks || resParams.ac_def);\n        var dc = Math.round(payload.dc_ticks || resParams.ac_def);\n\n        flow.set(\"motion_params\", { sp: sp, ac: ac, dc: dc });\n\n        elmoCmd = joinCmds(\n            cmdStr(\"SP\", sp),\";\",\n            cmdStr(\"AC\", ac),\";\",\n            cmdStr(\"DC\", dc),\";\",\n        );\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"motor_on\" — включение привода\n    // Мануал раздел 3: перед MO=1 биты SR[0-3] должны быть 0\n    // ────────────────────────────────────────────────────────────────────\n    case \"motor_on\":\n        elmoCmd = joinCmds(\"MO=1\", \"SO?\");\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"motor_off\" — выключение привода\n    // ────────────────────────────────────────────────────────────────────\n    case \"motor_off\":\n        elmoCmd = \"MO=0\";\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"drive_stop\" — быстрая остановка с замедлением QS\n    // ────────────────────────────────────────────────────────────────────\n    case \"drive_stop\":\n        elmoCmd = \"ST\";\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"drive_bg\" — запуск последней заданной команды (PA/PR/JV/JP)\n    // ────────────────────────────────────────────────────────────────────\n    case \"drive_bg\":\n        elmoCmd = \"BG\";\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"driveInit\" — инициализация привода по приложению А к ТЗ.\n    //\n    // Назначение:\n    //   1. Сопоставить шкалу инкрементного энкодера и полюса двигателя\n    //      через штатный запуск привода MO=1.\n    //   2. Выполнить один оборот планшайбы для инициализации сумматора DSi.\n    //\n    // payload опционален:\n    //   { resolution: \"high\" | \"low\" } — если перед инициализацией нужно\n    //   явно выбрать пару считывающих головок. Без payload используется\n    //   текущее flow \"resolution\".\n    // ────────────────────────────────────────────────────────────────────\n    case \"driveInit\":\n    case \"drive_init\":\n        var initRes = RES[currentRes] ? currentRes : \"high\";\n        if (payload && payload.resolution) {\n            initRes = (payload.resolution === \"low\") ? \"low\" : \"high\";\n        }\n\n        var init = RES[initRes];\n        var initMotion = {\n            sp: init.sp_def,\n            ac: init.ac_def,\n            dc: init.ac_def,\n        };\n\n        flow.set(\"resolution\", initRes);\n        flow.set(\"motion_params\", initMotion);\n\n        elmoCmd = [\n            \"ST\",\n            \"MO=0\",\n        ].concat(\n            resolutionSetupCmds(init),\n            [\n                \"AF=0\",\n                \"EC=0\",\n                \"SR\",\n                \"MF\",\n                \"EE[5]\",\n                \"MO=1\",\n                \"SO\",\n                cmdStr(\"SP\", initMotion.sp),\n                cmdStr(\"AC\", initMotion.ac),\n                cmdStr(\"DC\", initMotion.dc),\n                cmdStr(\"PR\", init.ca18),\n                \"BG\",\n                \"MS\",\n                \"PX\",\n                \"VX\",\n                \"MO\",\n                \"SO\",\n                \"SR\",\n                \"EC\",\n                \"MF\",\n                \"EE[5]\",\n                \"OL[1]\",\n                \"CA[18]\",\n                \"SP\",\n                \"AC\",\n                \"DC\",\n            ]\n        ).join(\";\\r\");\n\n        node.log(\"driveInit → \" + initRes + \" (one turn PR=\" + init.ca18 + \")\");\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"drive_home\" — поиск нулевой метки\n    // Мануал раздел 6: только через TCP (не UDP)\n    // ────────────────────────────────────────────────────────────────────\n    case \"drive_home\":\n        elmoCmd = \"HM[1]=1;\";\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"set_resolution\" — переключение пар считывающих головок ДУ\n    // payload: { resolution: \"high\" | \"low\" }\n    //\n    // Мануал раздел 4, алгоритм переключения головок:\n    //   1. Выключить привод (SO=0) — проверяется на стороне UI\n    //   2. Задать OL[1], CA[18], S1[5], KP[2], SD, QS,\n    //      VH[1], VL[1], VH[2], ER[3], ER[2], TR[1], TR[3]\n    //   3. Сохранить разрешение в flow context\n    //   4. Сбросить сохранённые параметры движения к дефолту нового разрешения\n    //\n    // Команды разбиты на несколько строк \\r для надёжного приёма по TCP.\n    // ────────────────────────────────────────────────────────────────────\n    case \"set_resolution\":\n        if (!payload || !payload.resolution) {\n            node.warn(\"set_resolution: нет payload.resolution\");\n            return null;\n        }\n\n        var newRes = (payload.resolution === \"high\") ? \"high\" : \"low\";\n        var r = RES[newRes];\n\n        // Сохраняем новое разрешение в flow context\n        flow.set(\"resolution\", newRes);\n\n        // Сбрасываем сохранённые параметры движения к безопасным дефолтам\n        // нового разрешения, чтобы следующие PA/PR не использовали\n        // тики старого разрешения\n        flow.set(\"motion_params\", {\n            sp: r.sp_def,\n            ac: r.ac_def,\n            dc: r.ac_def,\n        });\n\n        // Полная последовательность согласно мануалу раздел 4\n        elmoCmd = resolutionSetupCmds(r).join(\";\\r\");\n\n        node.log(\"set_resolution → \" + newRes + \" (OL[1]=\" + r.ol1 + \", CA[18]=\" + r.ca18 + \")\");\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"set_velocity\" — непрерывное вращение со скоростью JV\n    // payload: { ticks_per_sec }\n    // Для остановки: ticks_per_sec = 0 → JV=0; BG\n    // ────────────────────────────────────────────────────────────────────\n    case \"set_velocity\":\n        if (!payload) { node.warn(\"set_velocity: нет payload\"); return null; }\n\n        var jv = Math.round(payload.ticks_per_sec || 0);\n        elmoCmd = joinCmds(\n            cmdStr(\"AC\", storedParams.ac),\n            cmdStr(\"DC\", storedParams.dc),\n            cmdStr(\"JV\", jv),\n            \"BG\"\n        );\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"set_absolute_position\" — абсолютное позиционирование PA\n    // payload: { ticks, sp_ticks?, ac_ticks?, dc_ticks? }\n    // Мануал раздел 5: SP; AC; DC; PA=N; BG\n    // ────────────────────────────────────────────────────────────────────\n    case \"set_absolute_position\":\n        if (!payload) { node.warn(\"set_absolute_position: нет payload\"); return null; }\n\n        var pa = Math.round(payload.ticks || 0);\n        var pa_sp = Math.round(payload.sp_ticks || storedParams.sp);\n        var pa_ac = Math.round(payload.ac_ticks || storedParams.ac);\n        var pa_dc = Math.round(payload.dc_ticks || storedParams.dc);\n\n        if (pa_sp === 0) {\n            node.warn(\"set_absolute_position: SP=0, движение невозможно. Задайте скорость в «Параметры движения».\");\n            return null;\n        }\n\n        elmoCmd = [\n            cmdStr(\"SP\", pa_sp),\n            cmdStr(\"AC\", pa_ac),\n            cmdStr(\"DC\", pa_dc),\n            cmdStr(\"PA\", pa),\n            \"BG\",\n        ].join(\";\\r\");\n        break;\n\n    // ────────────────────────────────────────────────────────────────────\n    // \"set_relative_position\" — относительное позиционирование PR\n    // payload: { ticks, sp_ticks?, ac_ticks?, dc_ticks? }\n    // Мануал раздел 5: SP; AC; DC; PR=N; BG\n    // ticks знаковый: + по часовой, − против часовой\n    // ────────────────────────────────────────────────────────────────────\n    case \"set_relative_position\":\n        if (!payload) { node.warn(\"set_relative_position: нет payload\"); return null; }\n\n        var pr = Math.round(payload.ticks || 0);\n        var pr_sp = Math.round(payload.sp_ticks || storedParams.sp);\n        var pr_ac = Math.round(payload.ac_ticks || storedParams.ac);\n        var pr_dc = Math.round(payload.dc_ticks || storedParams.dc);\n\n        if (pr_sp === 0) {\n            node.warn(\"set_relative_position: SP=0, движение невозможно. Задайте скорость в «Параметры движения».\");\n            return null;\n        }\n\n        elmoCmd = joinCmds(\n            cmdStr(\"SP\", pr_sp),\n            cmdStr(\"AC\", pr_ac),\n            cmdStr(\"DC\", pr_dc),\n            cmdStr(\"PR\", pr),\n            \"BG\"\n        );\n        break;\n\n    default:\n        node.warn(\"Неизвестный топик: \" + topic);\n        return null;\n}\n\n// CR — обязательный терминатор команды для Elmo Platinum\nmsg.payload = elmoCmd + \"\\r\";\nmsg.elmo_topic = topic;\n\nnode.log(\"[\" + topic + \"] → \" + elmoCmd);\n\nreturn msg;\n",
