    {
        "id": "8ce9d9b486d972b8",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": " BUV Calibration",
        "func": "var ch_in = global.get(\"v1_inp\"),\n    ch_out = global.get(\"v1_out\"),\n    calib_use = global.get(\"use_calib\");\n\nmsg.calib_use = calib_use;\n\nif (calib_use == 0) \n{\n    msg.ignore = 1;\n    return msg;\n\n}\n\nvar ch_diff = ch_in.payload - ch_out.payload;\n\nmsg.velocity += ch_diff;\n\nreturn msg;\n\n\n\n\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
