    {
        "id": "f23b212fb8fc1db0",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": "ToHex",
        "func": "\n\n\nvar buffer = new ArrayBuffer(8);\nvar longNum = new Float64Array(buffer);\nlongNum[0] = msg.payload;\n\nmsg.hex = Array.from(new Uint8Array(buffer)).reverse();\n\nmsg.word0 = msg.hex[0]*256 + msg.hex[1];\nmsg.word1 = msg.hex[2]*256 + msg.hex[3];\n\nvar msg0 = {payload: msg.word0};\nvar msg1 = {payload: msg.word1};\nreturn [msg0, msg1];\n//return msg;",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 740,
        "wires": [
            [
                "3ec4b03695e9473c"
            ],
            [
                "f174f3ccf9ee1303"
            ]
        ]
    },
    {
        "id": "ecabf84bf053c774",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": "ToString",
        "func": "\n\nlet var_stat = msg.payload[0]*65536 + msg.payload[1];\n\nmsg.hex = \"0x\" + var_stat.toString(16);\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1000,
        "y": 1100,
        "wires": [
            [
                "a28f99a9965dd1a7",
                "bbd55d4f6a31f64d"
            ]
        ]
    },
