    {
        "id": "1868a08e1fcac6db",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": "Form array for file",
        "func": "//read from flow vars & form string for FileWrite\n\nvar m = global.get([\"v1_inp\", \"v1_out\",\n    \"v2_inp\", \"v2_out\",\n    \"v1_gap_inp\", \"v1_gap_out\",\n    \"v2_gap_inp\", \"v2_gap_out\",\n    \"v3_gap_inp\", \"v3_gap_out\",\n    \"v4_gap_inp\", \"v4_gap_out\",\n    \"v5_gap_inp\", \"v5_gap_out\",\n    \"use_calib\"]);\n\n\nvar b = \"\";\n\nfor(let pos = 0; pos < 2*2 + 5*2 + 1; pos++)\n{\n    if (m[pos].payload == undefined) b += String(m[pos]);\n    else b += String(m[pos].payload);\n\n    if (pos != 2 * 2 + 5 * 2) b += \" \";\n\n}\n\nmsg.payload = b;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 2900,
        "wires": [
            [
                "b9c61bcf87694b5c"
            ]
        ]
    },
    {
        "id": "c7a81d500c1f8adb",
