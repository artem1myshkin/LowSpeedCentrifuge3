    {
        "id": "e7b4f5538231f452",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "g": "52568354c3badd48",
        "name": "ToString",
        "func": "msg.src = msg.payload;\n\nmsg.payload = \"0x\" + msg.payload.toString(16);\n\n//to bits\nmsg.byte5_bit0 = msg.src & 0x0001;//stop_i\nmsg.byte5_bit1 = (msg.src & 0x0002)>>1;//IB3\nmsg.byte5_bit2 = (msg.src & 0x0004)>>2;//IB4\nmsg.byte5_bit3 = (msg.src & 0x0008)>>3;//nFault\n\nmsg.byte6_bit0 = (msg.src & 0x0100)>>8;//OBL\nmsg.byte6_bit1 = (msg.src & 0x0200)>>9;//OBH\nmsg.byte6_bit2 = (msg.src & 0x0400)>>10;//MEZ_E\nmsg.byte6_bit3 = (msg.src & 0x0800)>>11;//STOP_E\n\nmsg.topic = \"bun_sysstate\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2120,
        "y": 420,
        "wires": [
            [
                "2ad82a0f02bba2ad"
            ]
        ]
    },
