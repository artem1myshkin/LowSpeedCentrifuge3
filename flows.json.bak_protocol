    {
        "id": "c3433222b2542d38",
        "type": "ui-template",
        "z": "5bbcbebf6ff74a86",
        "g": "768318bb2b74ee44",
        "group": "eb32c959bf58e08d",
        "page": "",
        "ui": "",
        "name": "Сценарии",
        "order": 2,
        "width": "5",
        "height": "40",
        "head": "",
        "format": "<template>\n  <v-container class=\"containter\">\n    <h1 class=\"mt-1 ml-4 mb-1\">Сценарии</h1>\n    <v-card class=\"elevation-4 pa-4\">\n\n      <v-row>\n        <!-- Список сценариев -->\n        <v-col cols=\"4\">\n          <v-card class=\"scenario-list-card pa-2\">\n            <v-subheader>Сценарии</v-subheader>\n            <div class=\"scenario-list-scroll\">\n              <v-list dense>\n                <v-list-item v-for=\"(scenario, index) in scenarios\" :key=\"scenario.id\" @click=\"selectScenario(index)\"\n                  :class=\"{ 'selected-scenario': selectedScenarioIndex === index }\">\n                  <v-list-item-content>\n                    <v-list-item-title>{{ scenario.name }}</v-list-item-title>\n                  </v-list-item-content>\n                </v-list-item>\n              </v-list>\n            </div>\n            <div class=\"mt-4 d-flex gap-2\">\n              <v-btn class=\"btn-add\" @click=\"addNewScenario\">Добавить</v-btn>\n              <v-btn class=\"btn-delete\" :disabled=\"selectedScenarioIndex === null\" @click=\"deleteScenario\">Удалить\n              </v-btn>\n            </div>\n          </v-card>\n        </v-col>\n\n        <!-- Параметры выбранного сценария -->\n        <v-col cols=\"8\">\n          <div v-if=\"selectedScenario\" class=\"mb-4\">\n            <h3>Параметры сценария: {{ selectedScenario.name }}</h3>\n\n            <v-list dense>\n              <v-list-item v-for=\"(mode, idx) in selectedScenario.modes\" :key=\"idx\">\n                <v-list-item-content>\n                  <v-list-item-title>\n                    Скорость: {{ mode.speed.deg }}° {{ mode.speed.min }}′ {{ mode.speed.sec }}″ , Длительность: {{\n                    mode.duration }} с\n                  </v-list-item-title>\n                </v-list-item-content>\n              </v-list-item>\n            </v-list>\n\n            <v-btn class=\"btn-edit mt-2\" @click=\"editScenario\">Редактировать сценарий</v-btn>\n          </div>\n\n          <!-- Форма добавления/редактирования сценария -->\n          <div v-if=\"addingScenario\" class=\"mt-4\">\n            <v-text-field v-model=\"newScenarioName\" label=\"Название сценария\" class=\"mb-4\"></v-text-field>\n\n            <div v-for=\"(mode, idx) in newScenarioModes\" :key=\"idx\" class=\"d-flex gap-2 align-center mb-2\">\n              <v-text-field v-model.number=\"mode.speed.deg\" label=\"Градусы (°)\" type=\"number\"></v-text-field>\n              <v-text-field v-model.number=\"mode.speed.min\" label=\"Минуты (′)\" type=\"number\"></v-text-field>\n              <v-text-field v-model.number=\"mode.speed.sec\" label=\"Секунды (″)\" type=\"number\"></v-text-field>\n              <v-text-field v-model.number=\"mode.duration\" label=\"Длительность (с)\" type=\"number\"></v-text-field>\n              <v-icon class=\"ml-2 cursor-pointer\" color=\"red\" @click=\"removeMode(idx)\">mdi-delete</v-icon>\n            </div>\n\n            <div class=\"d-flex gap-2 mt-2\">\n              <v-btn class=\"btn-add-mode\" @click=\"addMode\">Добавить режим</v-btn>\n              <v-btn class=\"btn-save\" @click=\"saveNewScenario\">Сохранить сценарий</v-btn>\n            </div>\n          </div>\n        </v-col>\n      </v-row>\n\n    </v-card>\n  </v-container>\n</template>\n\n<script>\n  export default {\n  name: 'ScenarioTab',\n  data() {\n    return {\n      scenarios: [\n        {\n          id: 1,\n          name: 'Сценарий 1',\n          modes: [\n            { speed: { deg: 10, min: 0, sec: 0 }, duration: 5 },\n            { speed: { deg: 20, min: 15, sec: 0 }, duration: 10 }\n          ]\n        },\n        {\n          id: 2,\n          name: 'Сценарий 2',\n          modes: [\n            { speed: { deg: 30, min: 0, sec: 0 }, duration: 15 }\n          ]\n        },\n        {\n        id: 3,\n        name: 'Сценарий 3',\n        modes: [\n        { speed: { deg: 10, min: 15, sec: 0 }, duration: 15 },\n        { speed: { deg: 0, min: 2, sec: 15 }, duration: 30 }\n        ]\n        }\n      ],\n      selectedScenarioIndex: null,\n      addingScenario: false,\n      newScenarioName: '',\n      newScenarioModes: [\n        { speed: { deg: 0, min: 0, sec: 0 }, duration: 0 }\n      ]\n    };\n  },\n  computed: {\n    selectedScenario() {\n      return this.selectedScenarioIndex !== null\n        ? this.scenarios[this.selectedScenarioIndex]\n        : null;\n    }\n  },\n  methods: {\n    selectScenario(index) {\n      this.selectedScenarioIndex = index;\n      this.addingScenario = false;\n    },\n    deleteScenario() {\n      if (this.selectedScenarioIndex !== null) {\n        this.scenarios.splice(this.selectedScenarioIndex, 1);\n        this.selectedScenarioIndex = null;\n      }\n    },\n    editScenario() {\n      if (this.selectedScenario) {\n        this.addingScenario = true;\n        this.newScenarioName = this.selectedScenario.name;\n        this.newScenarioModes = JSON.parse(JSON.stringify(this.selectedScenario.modes));\n      }\n    },\n    addNewScenario() {\n      this.addingScenario = true;\n      this.newScenarioName = '';\n      this.newScenarioModes = [\n        { speed: { deg: 0, min: 0, sec: 0 }, duration: 0 }\n      ];\n    },\n    addMode() {\n      this.newScenarioModes.push({ speed: { deg: 0, min: 0, sec: 0 }, duration: 0 });\n    },\n    removeMode(idx) {\n      this.newScenarioModes.splice(idx, 1);\n    },\n    saveNewScenario() {\n      if (!this.newScenarioName) {\n        alert('Введите название сценария');\n        return;\n      }\n\n      // Фильтруем пустые режимы\n      const filteredModes = this.newScenarioModes.filter(m => {\n        const s = m.speed;\n        return !(s.deg === 0 && s.min === 0 && s.sec === 0 && m.duration === 0);\n      });\n\n      if (!filteredModes.length) {\n        alert('Нельзя сохранить сценарий без режимов');\n        return;\n      }\n\n      const newId = this.scenarios.length\n        ? Math.max(...this.scenarios.map(s => s.id)) + 1\n        : 1;\n\n      const newScenario = {\n        id: newId,\n        name: this.newScenarioName,\n        modes: filteredModes\n      };\n\n      if (this.selectedScenarioIndex !== null && this.addingScenario) {\n        // редактирование\n        this.scenarios.splice(this.selectedScenarioIndex, 1, newScenario);\n      } else {\n        this.scenarios.push(newScenario);\n      }\n\n      this.addingScenario = false;\n      this.selectedScenarioIndex = this.scenarios.findIndex(s => s.id === newId);\n    }\n  }\n};\n</script>\n\n<style scoped>\n  .containter {\n    display: flex;\n    flex-direction: column;\n    gap: 0px;\n    margin: 0px;\n  }\n\n  .title-top {\n    font-size: 18px;\n  }\n\n  .scenario-list-card {\n    display: flex;\n    flex-direction: column;\n    height: 400px;\n    /* фиксированная высота */\n  }\n\n  .scenario-list-scroll {\n    flex: 1;\n    overflow-y: auto;\n  }\n\n  .selected-scenario {\n    background-color: #e0f7fa;\n  }\n\n  /* Кнопки одного размера для Добавить / Удалить */\n  .btn-add {\n    background: #49ed40;\n    min-width: 120px;\n    height: 40px;\n    font-size: 14px;\n  }\n\n  .btn-delete {\n    background: #b80932;\n    min-width: 120px;\n    height: 40px;\n    font-size: 14px;\n  }\n\n  /* Разные цвета для других кнопок */\n  .btn-edit {\n    background: #ff9800;\n    /* оранжевый */\n    color: white;\n    font-size: 14px;\n    min-width: 140px;\n    height: 40px;\n  }\n\n  .btn-add-mode {\n    background: #03a9f4;\n    /* голубой */\n    color: white;\n    font-size: 14px;\n    min-width: 140px;\n    height: 40px;\n  }\n\n  .btn-save {\n    background: #9c27b0;\n    /* фиолетовый */\n    color: white;\n    font-size: 14px;\n    min-width: 140px;\n    height: 40px;\n  }\n\n  .cursor-pointer {\n    cursor: pointer;\n  }\n</style>",
