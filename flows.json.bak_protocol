    {
        "id": "a564674a20d039a1",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": "torque_convert",
        "func": "let a = msg.payload[16]*65536 + msg.payload[17];\nlet rez = (a & 0xfffff | 0x100000) * 1.0 / Math.pow(2, 52 - 32) * Math.pow(2, ((a >> 52 - 32 & 0x7ff) - 1023));\n\nif (rez < 0.00001) rez = 0;\n\n//round to 0.001\nrez = Math.round(rez*1000)/1000;\n\nmsg.raw_angle = a;\nmsg.torque = rez;\nreturn msg;",
        "outputs": 1,
