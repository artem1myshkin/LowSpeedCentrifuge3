    {
        "id": "e07f1c095ff4f484",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": "ToString",
        "func": "msg.src = msg.payload;\n\nmsg.payload = \"0x\" + msg.payload.toString(16);\n\n//to bits\nmsg.byte5_bit0 = msg.src & 0x0001;//stop_i\nmsg.byte5_bit1 = (msg.src & 0x0002)>>1;//IB3\nmsg.byte5_bit2 = (msg.src & 0x0004)>>2;//IB4\nmsg.byte5_bit3 = (msg.src & 0x0008)>>3;//nFault\n\nmsg.byte6_bit0 = (msg.src & 0x0100)>>8;//OBL\nmsg.byte6_bit1 = (msg.src & 0x0200)>>9;//OBH\nmsg.byte6_bit2 = (msg.src & 0x0400)>>10;//MEZ_E\nmsg.byte6_bit3 = (msg.src & 0x0800)>>11;//STOP_E\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,
        "y": 100,
        "wires": [
            [
                "0c28c08d8b0cc386",
                "40f807c24dec9086",
                "b355d15c87b456ad",
                "48d3146e2efb9146",
