    {
        "id": "4754c64909f47b4d",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": "vel_convert2",
        "func": "let a = msg.payload[0]*65536 + msg.payload[1];\nlet rez = (a & 0xfffff | 0x100000) * 1.0 / Math.pow(2, 52 - 32) * Math.pow(2, ((a >> 52 - 32 & 0x7ff) - 1023));\n\nif (rez < 0.00001) rez = 0;\n\nmsg.raw_angle = a;\nmsg.velocity = rez;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 970,
        "y": 2440,
        "wires": [
            [
                "9b98e3c42c37f2da"
