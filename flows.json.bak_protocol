    {
        "id": "bf4f871ff787a26f",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "g": "768318bb2b74ee44",
        "name": "function 5",
        "func": "// ─────────────────────────────────────────\n// DEBUG NODE — чтение параметров Elmo\n// 6 topic для inject\n// ─────────────────────────────────────────\n\nfunction cmdStr(cmd, value) {\n    if (value === undefined || value === null) return cmd;\n    return cmd + \"=\" + value;\n}\n\nfunction joinCmds() {\n    var cmds = Array.isArray(arguments[0]) ? arguments[0] : Array.prototype.slice.call(arguments);\n    return cmds.filter(Boolean).join(\";\");\n}\n\nvar topic = msg.topic;\nvar elmoCmd = null;\n\nswitch (topic) {\n\n    // 1. Скорость (уставка)\n    case \"get_speed\":\n        elmoCmd = \"SP;\";\n        break;\n\n    // 2. Ускорение\n    case \"get_acceleration\":\n        elmoCmd = \"AC;\";\n        break;\n\n    // 3. Замедление\n    case \"get_deceleration\":\n        elmoCmd = \"DC;\";\n        break;\n\n    // 4. \"Рывок\" (по факту скорость вращения JV)\n    case \"get_jerk\":\n        elmoCmd = \"JV;\";\n        break;\n\n    // 5. Текущая позиция (факт)\n    case \"get_position\":\n        elmoCmd = \"PX;\";\n        break;\n\n    // 6. Абсолютная цель\n    case \"get_target_position\":\n        elmoCmd = \"PA;\";\n        break;\n\n    case \"get_curr_speed\":\n        elmoCmd = \"VX;\";\n        break;    \n\n    default:\n        node.warn(\"Неизвестный topic: \" + topic);\n        return null;\n}\n\n// отправка в привод\nmsg.payload = elmoCmd + \"\\r\";\nmsg.elmo_topic = topic;\n\nnode.log(\"[\" + topic + \"] → \" + elmoCmd);\n\nreturn msg;",
