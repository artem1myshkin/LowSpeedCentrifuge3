    {
        "id": "f46be61cc0d13630",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "g": "768318bb2b74ee44",
        "name": "ResponseParser",
        "func": "// ─────────────────────────────────────────────────────────────────────────\n// UNIVERSAL Elmo Parser + SR decode\n//\n// Ключевые принципы:\n//   • msg.topic НИКОГДА не меняется — фронт фильтрует сам\n//   • Единый токенизатор для всех форматов ответов Elmo:\n//       Формат A: PARAM=VALUE[;PARAM=VALUE;…]  → \"SP=9102;AC=910;DC=910\"\n//       Формат B: PARAM;VALUE[;PARAM;VALUE;…]  → \"MS;0;PX;2808089\"\n//       (\\r\\n внутри строки нормализуется в \";\")\n//   • Нет init-буфера: SP/AC/DC идут напрямую в payload\n//   • buildPollData возвращает полный снимок poll-буфера с оригинальным topic\n// ─────────────────────────────────────────────────────────────────────────\n\nfunction decodeSR(sr) {\n    var bin = (sr >>> 0).toString(2).padStart(32, \"0\");\n    var lowBits = bin.slice(-4);\n    var errors = [];\n\n    if (lowBits !== \"0000\") {\n        errors.push(\"Amplifier fault (bits 0-3 != 0)\");\n    }\n\n    var bitMap = {\n        3: \"Undervoltage\",\n        5: \"Overvoltage\",\n        7: \"Safety (STO active)\",\n        9: \"Sensor error\",\n        11: \"Short circuit\",\n        12: \"Abort input active\",\n        13: \"Drive over temperature\",\n        14: \"Motor over temperature\",\n        15: \"Additional abort\",\n    };\n\n    Object.keys(bitMap).forEach(function (bit) {\n        var idx = 31 - Number(bit);\n        if (bin[idx] === \"1\") {\n            errors.push(bitMap[bit]);\n        }\n    });\n\n    return {\n        raw: sr,\n        binary: bin,\n        amplifier_bits_0_3: lowBits,\n        ok: lowBits === \"0000\",\n        errors: errors,\n    };\n}\n\nfunction parseElmoNumber(value) {\n    var text = String(value || \"\").trim();\n    if (!text) return NaN;\n    return Number(text);\n}\n\nfunction applyParam(poll, param, value) {\n    switch (param) {\n        case \"PX\": poll.position = value; break;\n        case \"VX\": poll.velocity = value; break;\n        case \"MS\": poll.ms = value; break;\n        case \"SO\": poll.so = (value === 1); break;\n        case \"MO\": poll.mo = (value === 1); break;\n        case \"SP\": poll.sp = value; break;\n        case \"AC\": poll.ac = value; break;\n        case \"DC\": poll.dc = value; break;\n        case \"JV\": poll.jv = value; break;\n        case \"TR[1]\": poll.tr1 = value; break;\n        case \"TR[3]\": poll.tr3 = value; break;\n        case \"PA\": poll.target_position = value; break;\n        case \"PR\": poll.relative_position = value; break;\n\n        case \"CA[18]\": poll.ca18 = value; break;\n        case \"S1[5]\": poll.s1_5 = value; break;\n        case \"KP[2]\": poll.kp2 = value; break;\n        case \"SD\": poll.sd = value; break;\n        case \"QS\": poll.qs = value; break;\n        case \"VH[1]\": poll.vh1 = value; break;\n        case \"VL[1]\": poll.vl1 = value; break;\n        case \"VH[2]\": poll.vh2 = value; break;\n        case \"ER[3]\": poll.er3 = value; break;\n        case \"ER[2]\": poll.er2 = value; break;\n        case \"EC\": poll.ec = value; break;\n        case \"MF\": poll.mf = value; break;\n        case \"EE[5]\": poll.ee5 = value; break;\n        case \"HM[1]\": poll.hm1 = value; break;\n\n        case \"AF\":\n            poll.af = value;\n            poll.remote_control_ok = (value === 0);\n            break;\n\n        case \"SR\":\n            poll.sr = value;\n            poll.sr_decoded = decodeSR(value);\n            break;\n\n        // OL[1]: мануал раздел 4 — 0=высокое, 1=низкое\n        case \"OL[1]\":\n            poll.ol1 = value;\n            poll.resolution = (value === 0) ? \"high\" : \"low\";\n            flow.set(\"resolution\", poll.resolution);\n            break;\n\n        // OL[2]: мануал раздел 7 — тормоз внешней оси БУН\n        // 0=тормоз выключен (ось свободна), 1=тормоз включён (ось зафиксирована)\n        case \"OL[2]\":\n            poll.ol2 = value;\n            poll.bun_brake = (value === 1);\n            flow.set(\"bun_brake\", poll.bun_brake);\n            break;\n\n        default:\n            node.log(\"Unknown param: \" + param);\n    }\n}\n\nfunction buildPollData(poll) {\n    return {\n        topic: msg.topic,   // оригинальный топик, не меняем\n        payload: {\n            position: poll.position !== undefined ? poll.position : 0,\n            velocity: poll.velocity !== undefined ? poll.velocity : 0,\n            ms: poll.ms !== undefined ? poll.ms : 3,\n            so: poll.so !== undefined ? poll.so : false,\n            mo: poll.mo !== undefined ? poll.mo : false,\n            af: poll.af !== undefined ? poll.af : 0,\n            remote_control_ok: poll.remote_control_ok !== undefined ? poll.remote_control_ok : true,\n            sp: poll.sp !== undefined ? poll.sp : 0,\n            ac: poll.ac !== undefined ? poll.ac : 0,\n            dc: poll.dc !== undefined ? poll.dc : 0,\n            jv: poll.jv !== undefined ? poll.jv : 0,\n            tr1: poll.tr1 !== undefined ? poll.tr1 : 0,\n            tr3: poll.tr3 !== undefined ? poll.tr3 : 0,\n            sr: poll.sr !== undefined ? poll.sr : 0,\n            ec: poll.ec !== undefined ? poll.ec : 0,\n            mf: poll.mf !== undefined ? poll.mf : 0,\n            ee5: poll.ee5 !== undefined ? poll.ee5 : 0,\n            ca18: poll.ca18 !== undefined ? poll.ca18 : 0,\n            s1_5: poll.s1_5 !== undefined ? poll.s1_5 : 0,\n            kp2: poll.kp2 !== undefined ? poll.kp2 : 0,\n            sd: poll.sd !== undefined ? poll.sd : 0,\n            qs: poll.qs !== undefined ? poll.qs : 0,\n            vh1: poll.vh1 !== undefined ? poll.vh1 : 0,\n            vl1: poll.vl1 !== undefined ? poll.vl1 : 0,\n            vh2: poll.vh2 !== undefined ? poll.vh2 : 0,\n            er3: poll.er3 !== undefined ? poll.er3 : 0,\n            er2: poll.er2 !== undefined ? poll.er2 : 0,\n            hm1: poll.hm1 !== undefined ? poll.hm1 : 0,\n            target_position: poll.target_position !== undefined ? poll.target_position : 0,\n            relative_position: poll.relative_position !== undefined ? poll.relative_position : 0,\n            sr_status: poll.sr_decoded || {\n                raw: 0,\n                binary: \"00000000000000000000000000000000\",\n                amplifier_bits_0_3: \"0000\",\n                ok: true,\n                errors: [],\n            },\n            torque: 0,\n            resolution: poll.resolution || flow.get(\"resolution\") || \"high\",\n            // Тормоз БУН (OL[2]): передаём в UI для синхронизации тумблера\n            bun_brake: poll.bun_brake !== undefined\n                ? poll.bun_brake\n                : (flow.get(\"bun_brake\") || false),\n        },\n    };\n}\n\n// ─────────────────────────────────────────────────────────────────────────\n// ВХОДНОЙ ПОТОК\n// ─────────────────────────────────────────────────────────────────────────\n\nvar raw = String(msg.payload || \"\");\nraw = raw.replace(/\\u0000/g, \"\").trim();\n\nif (!raw) return null;\n\nraw = raw.replace(/^\"+|\"+$/g, \"\");\n\nif (raw === \";\" || raw === \"BG\" || raw === \":?\") {\n    return null;\n}\n\n// Нормализация: \\r\\n → \";\", схлопываем повторные \";\", убираем крайние\nraw = raw.replace(/[\\r\\n]+/g, \";\")\n    .replace(/;{2,}/g, \";\")\n    .replace(/^;|;$/g, \"\");\n\nif (!raw) return null;\n\nvar tokens = raw.split(\";\")\n    .map(function (s) { return s.trim(); })\n    .filter(Boolean);\n\nif (tokens.length === 0) return null;\n\nvar poll = flow.get(\"poll_buffer\") || {};\n\n// Поддерживаем смешанный ответ:\n//   \"SP=9102;AC=910;MS;0;PX;2808089\"\n// Это важно для driveInit, где в одном пакете могут встретиться эхо записи\n// и ответы на чтение состояния.\nfor (var i = 0; i < tokens.length; i++) {\n    var token = tokens[i];\n    var eqIdx = token.indexOf(\"=\");\n\n    if (eqIdx !== -1) {\n        var pA = token.slice(0, eqIdx).trim().toUpperCase();\n        var vA = parseElmoNumber(token.slice(eqIdx + 1));\n        if (!isNaN(vA)) applyParam(poll, pA, vA);\n        continue;\n    }\n\n    if (i + 1 >= tokens.length || tokens[i + 1].indexOf(\"=\") !== -1) {\n        continue;\n    }\n\n    var pB = token.toUpperCase();\n    var vB = parseElmoNumber(tokens[i + 1]);\n    if (!isNaN(vB)) {\n        applyParam(poll, pB, vB);\n        i++;\n    }\n}\n\nflow.set(\"poll_buffer\", poll);\n\nreturn buildPollData(poll);\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1910,
        "y": 1120,
