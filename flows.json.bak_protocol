    {
        "id": "6bf3697a49fd5702",
        "type": "function",
        "z": "5bbcbebf6ff74a86",
        "g": "52568354c3badd48",
        "name": "BEP Calibration",
        "func": "var ch1_in = global.get(\"v1_gap_inp\"),\n    ch1_out = global.get(\"v1_gap_out\"),\n    ch2_in = global.get(\"v2_gap_inp\"),\n    ch2_out = global.get(\"v2_gap_out\"),\n    ch3_in = global.get(\"v3_gap_inp\"),\n    ch3_out = global.get(\"v3_gap_out\"),\n    ch4_in = global.get(\"v4_gap_inp\"),\n    ch4_out = global.get(\"v4_gap_out\"),\n    ch5_in = global.get(\"v5_gap_inp\"),\n    ch5_out = global.get(\"v5_gap_out\"),\n    calib_use = global.get(\"use_calib\");\n\nmsg.calib_use = calib_use;\n\nif (calib_use == 0) \n{\n    msg.ignore = 1;\n\n    if (msg.topic == \"Channel 1\")      return [msg, msg, 0, 0, 0, 0];\n    else if (msg.topic == \"Channel 2\") return [msg, 0, msg, 0, 0, 0];\n    else if (msg.topic == \"Channel 3\") return [msg, 0, 0, msg, 0, 0];\n    else if (msg.topic == \"Channel 4\") return [msg, 0, 0, 0, msg, 0];\n    else if (msg.topic == \"Channel 5\") return [msg, 0, 0, 0, 0, msg];\n    else return [0, 0, 0, 0, 0, 0];\n\n}\n\n\nvar ch1_diff = ch1_in.payload - ch1_out.payload,\n    ch2_diff = ch2_in.payload - ch2_out.payload,\n    ch3_diff = ch3_in.payload - ch3_out.payload,\n    ch4_diff = ch4_in.payload - ch4_out.payload,\n    ch5_diff = ch5_in.payload - ch5_out.payload,\n    k = 0;\n\nmsg.k = k;\n\n\nif (msg.topic == \"Channel 1\") \n{\n    msg.payload += ch1_diff;k=1;\n    return [msg, msg, 0,0,0,0];\n}\nelse if (msg.topic == \"Channel 2\") \n{ \n    msg.payload += ch2_diff; k = 2; \n    return [msg, 0, msg, 0, 0, 0];\n}\nelse if (msg.topic == \"Channel 3\") \n{ \n    msg.payload += ch3_diff; k = 3; \n    return [msg, 0, 0, msg, 0, 0];\n}\nelse if (msg.topic == \"Channel 4\") \n{ \n    msg.payload += ch4_diff; k = 4; \n    return [msg, 0, 0, 0, msg, 0];\n}\nelse if (msg.topic == \"Channel 5\") \n{ \n    msg.payload += ch5_diff; k = 5; \n    return [msg, 0, 0, 0, 0, msg];\n}\n\n\n\n",
