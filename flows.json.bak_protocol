    {
        "id": "c32feeaae8d9fdb0",
        "type": "function",
        "z": "25e98403b083ddbb",
        "name": "Update flow var",
        "func": "\n//var k_msg = msg;\n\n\n//read (object copy type)\n//k_msg = flow.get(msg.topic);\n\n//set\n//k_msg.topic = msg.topic;\n//k_msg.payload = msg.payload;\n\n//set flow var\nif (msg.topic == \"use_calib\")\n{\n    if (msg.payload == true) global.set(msg.topic, 1);\n    else global.set(msg.topic, 0);\n\n}\nelse global.set(msg.topic, msg.payload);\n\n//check what set\n\nvar k_msg = global.get(msg.topic);\nmsg.readed = k_msg;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 3380,
        "wires": [
            []
        ]
    },
    {
        "id": "db798f2d079ed326",
